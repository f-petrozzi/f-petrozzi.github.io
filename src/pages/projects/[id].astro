---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---

<Base
  title={`${project.data.title} | Fabrizio Petrozzi`}
  description={project.data.summary}
>
  <main id="main" class="project-page wrap">
    <a href="/#projects" class="text-link">← Back to the collection</a><div
      class="eyebrow"
    >
      {project.data.category} / {project.data.status}
    </div><h1>{project.data.title}</h1><p class="project-intro">
      {project.data.summary}
    </p><ul class="tool-list">
      {project.data.tools.map((tool) => <li>{tool}</li>)}
    </ul><div class="project-actions">
      {
        project.data.repo && (
          <a class="pill-link" href={project.data.repo}>
            View repository
          </a>
        )
      }{
        project.data.demo && (
          <a class="pill-link" href={project.data.demo}>
            Visit demo
          </a>
        )
      }
    </div>{
      project.data.featured && (
        <ProjectVisual kind={project.data.visual} title={project.data.title} />
      )
    }<div class="prose"><Content /></div><a class="text-link" href="/#projects"
      >← Explore more projects</a
    >
  </main>
</Base>
