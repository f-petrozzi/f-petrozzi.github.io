---
import Base from "../../../layouts/Base.astro";
import AutoclickerDemo from "../../../components/demos/AutoclickerDemo.astro";
---

<Base
  title="Personal Autoclicker interactive sample | Fabrizio Petrozzi"
  description="A disconnected interactive sample of the Personal Autoclicker window, clicking a target inside the page."
>
  <main id="main" class="project-page wrap demo-page">
    <a class="back-link" href="/projects/autoclicker/"
      >Back to Personal Autoclicker</a
    >
    <header class="demo-intro">
      <div>
        <p class="eyebrow">Interactive sample</p><h1>
          Try Personal Autoclicker
        </h1>
      </div><p>Sample data. Nothing connects or saves.</p>
    </header>
    <AutoclickerDemo />
  </main>
</Base>

<style>
  .demo-page {
    padding-top: 40px;
    padding-bottom: 72px;
  }
  .demo-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 12px 24px;
    margin: 24px 0;
  }
  .demo-intro h1 {
    margin: 6px 0 0;
    font-size: clamp(32px, 5vw, 52px);
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .demo-intro > p {
    color: var(--muted);
    font-size: 14px;
  }
</style>
