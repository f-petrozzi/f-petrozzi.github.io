---
import ImageViewer from "../components/ImageViewer.astro";
import QuickPreview from "../components/QuickPreview.astro";
import ScrollControl from "../components/ScrollControl.astro";
import { getCollection } from "astro:content";
import "../styles/tokens.css";
import "../styles/home.css";
import "../styles/fluid.css";
import Icon from "../components/Icon.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { featured as featuredCopy } from "../data/featured";
import ToolIcon from "../components/ToolIcon.astro";
import ToolIconSprite from "../components/ToolIconSprite.astro";
const raw = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const byId = Object.fromEntries(raw.map((p) => [p.id, p]));
const featured = featuredCopy.map((copy) => ({
  ...copy,
  project: byId[copy.id],
}));
const recent = raw.filter((p) => p.data.category !== "Earlier work");
const earlier = raw.filter((p) => p.data.category === "Earlier work");
const capabilities = {
  orbit: ["ai", "web"],
  nest: ["ai", "web"],
  nume: ["ai", "web"],
  proterra: ["data", "web"],
  homelab: ["infra"],
  "agent-usage": ["desktop"],
  slice: ["web", "data"],
  autoclicker: ["desktop"],
  caremesh: ["ai", "web"],
  "usf-campus-concierge": ["ai"],
  optuna: ["ai"],
  eduinsight: ["web"],
  "todoo-app": ["web"],
  portfolio: ["web"],
  "image-classifier": ["ai"],
  "hospital-data-warehouse": ["data"],
  "business-statistics": ["data"],
  "text-cleaning-analyzing": ["data"],
  "product-reviews-analysis": ["data"],
  "titanic-survival-predictor": ["ai"],
  "tixly-app-design": ["design"],
  mongodb: ["data"],
};
const facets = [
  ["all", "All work"],
  ["web", "Web apps"],
  ["ai", "AI"],
  ["data", "Data"],
  ["infra", "Infrastructure"],
  ["desktop", "Desktop"],
  ["design", "Design"],
];

const facetIcons = {
  all: "grid",
  web: "globe",
  ai: "brain-circuit",
  data: "database",
  infra: "server",
  desktop: "monitor-smartphone",
  design: "pen-tool",
};
const projectIcons = {
  nest: "home",
  nume: "brain-circuit",
  proterra: "book",
  slice: "pizza",
  caremesh: "brain-circuit",
  autoclicker: "monitor-smartphone",
  "agent-usage": "monitor-smartphone",
};
const experience = [
  {
    year: "2023",
    when: "Nov 2023 - Aug 2024",
    org: "Raymond James",
    role: "Managed Customer Accounts Associate",
    icon: "briefcase",
    logo: "/assets/org/rj.svg",
    description:
      "I reviewed daily client transactions and built an Excel workflow to flag accounts for reconciliation.",
  },
  {
    year: "2024",
    when: "Aug 2024 - May 2025",
    org: "USF MUMA College of Business",
    role: "Graduate Teaching Assistant",
    icon: "graduation-cap",
    logo: "/assets/org/usf.svg",
    description:
      "I helped Computers in Business students with Excel, Word, Teams and assignments.",
  },
  {
    year: "2026",
    when: "Feb - May 2026",
    org: "University of South Florida",
    role: "Audio Visual Technician",
    icon: "audio",
    logo: "/assets/org/usf.svg",
    description:
      "I troubleshot classroom technology, documented issues and resolved them with faculty and IT.",
  },
  {
    year: "2026",
    when: "Jul - Aug 2026",
    org: "Handshake AI",
    role: "AI Evaluation Contractor and Reviewer",
    icon: "brain-circuit",
    logo: "/assets/org/handshake.svg",
    description:
      "I wrote AI evaluation scenarios and reviewed contributors’ prompts for realism and quality.",
  },
  {
    year: "2026",
    when: "Jul - Oct 2026",
    org: "Slice of the Burg",
    role: "Freelance Data and Technology Consultant",
    icon: "pizza",
    logo: "/assets/org/slice.webp",
    description:
      "I planned technology improvements with the owners and analyzed Toast menu performance.",
  },
  {
    year: "2026",
    when: "2026 - Present",
    org: "Raymond James",
    role: "Business Transformation AI Enablement (Finance) Analyst",
    icon: "briefcase",
    logo: "/assets/org/rj.svg",
    description:
      "I work on AI enablement within Business Transformation in Finance.",
    current: true,
  },
];
const education = [
  {
    year: "2019",
    when: "Aug 2019 - Aug 2023",
    org: "University of South Florida",
    role: "B.S. Business Management",
    icon: "graduation-cap",
    logo: "/assets/org/usf.svg",
    description:
      "I joined the Honors College, made the Dean’s List and received the Golden Bull Award and MUMA 25 under 25 honor.",
    mark: "3.98 GPA",
  },
  {
    year: "2024",
    when: "Aug 2024 - May 2026",
    org: "University of South Florida",
    role: "M.S. Artificial Intelligence & Business Analytics",
    icon: "graduation-cap",
    logo: "/assets/org/usf.svg",
    description:
      "I applied machine learning, text analytics, data warehousing and systems design in course projects.",
    mark: "4.0 GPA",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fabrizio Petrozzi</title>
    <meta
      name="description"
      content="Fabrizio Petrozzi’s apps, tools and work with AI. Projects, background and contact."
    />
    <link rel="canonical" href={new URL("/", Astro.site)} />
    <meta property="og:title" content="Fabrizio Petrozzi" />
    <meta
      property="og:description"
      content="I build apps and tools. I explore how AI works and what I can build with it."
    />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0f18" />
    <script is:inline>
      document.documentElement.classList.add("timeline-js");
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
        document.documentElement.classList.add("timeline-motion");
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("portfolio-theme") === "light"
            ? "light"
            : "dark";
      } catch {}
    </script>
    <link rel="stylesheet" href="/assets/fonts/fonts.css" />
    <link
      rel="preload"
      href="/assets/fonts/instrument-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/era.css" />
    <link rel="expect" href="#era-ready" blocking="render" />
    <script src="/era.js" is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#page-content">Skip to content</a>
    <ScrollControl controls="page-content" />
    <SiteHeader home />
    <ToolIconSprite tools={raw.flatMap((p) => p.data.tools.slice(0, 5))} />
    <main id="page-content" class="home">
      <span class="field field-hero-a" aria-hidden="true"></span>
      <span class="field field-hero-b" aria-hidden="true"></span>
      <span class="field field-work" aria-hidden="true"></span>
      <span class="field field-index" aria-hidden="true"></span>

      <section class="hero wrap" id="top" aria-labelledby="intro-title">
        <h1 id="intro-title">
          Fabrizio Petrozzi<span class="name-period">.</span>
        </h1>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-lead">I build apps and tools.</p>
            <p class="hero-sub">
              I explore how AI works and what I can build with it.
            </p>
            <ul class="hero-links" aria-label="Profiles and résumé">
              <li>
                <a href="/files/resume.pdf"><Icon name="file-text" />Résumé</a>
              </li>
              <li>
                <a href="https://github.com/f-petrozzi"
                  ><Icon name="github" />GitHub</a
                >
              </li>
              <li>
                <a href="https://www.linkedin.com/in/fabriziopetrozzi/"
                  ><Icon name="linkedin" />LinkedIn</a
                >
              </li>
              <li><a href="#contact"><Icon name="mail" />Email</a></li>
            </ul>
          </div>
          <dl class="hero-facts">
            <div>
              <dt><Icon name="briefcase" /><span class="sr-only">Now</span></dt>
              <dd>AI Enablement Analyst at Raymond James</dd>
            </div>
            <div>
              <dt>
                <Icon name="graduation-cap" /><span class="sr-only"
                  >Studied</span
                >
              </dt>
              <dd>M.S. AI &amp; Business Analytics, USF</dd>
            </div>
            <div>
              <dt>
                <Icon name="map-pin" /><span class="sr-only">Based in</span>
              </dt>
              <dd>St. Petersburg, Florida</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="work wrap" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <h2 id="work-title">Selected work</h2>
        </div>
        <div class="bento">
          {
            featured.map(
              ({ id, project, summary, hook, how, contribution, image }) => (
                <article
                  class="work-card"
                  aria-labelledby={`work-${id}`}
                  data-project={id}
                >
                  <header class="work-heading">
                    <h3 id={`work-${id}`}>
                      <a href={`/projects/${id}/`}>{project.data.title}</a>
                    </h3>
                    <p class="work-summary">{summary}</p>
                  </header>
                  <div class="work-stage">
                    <button
                      class="work-media screenshot-open"
                      type="button"
                      disabled
                      aria-label={`Preview ${project.data.title}`}
                    >
                      <img
                        src={image?.src}
                        width={image?.width}
                        height={image?.height}
                        alt={image?.alt}
                        loading={id === "orbit" ? "eager" : "lazy"}
                        fetchpriority={id === "orbit" ? "high" : "auto"}
                        decoding="async"
                      />
                    </button>
                  </div>
                  <div class="work-body">
                    <details class="work-more">
                      <summary aria-controls={`info-${id}`}>
                        <span class="more-closed">
                          <>
                            <Icon name="info" />
                            <span class="sr-only">
                              About {project.data.title}
                            </span>
                          </>
                        </span>
                        <span class="more-open">
                          <>
                            <Icon name="close" />
                            <span class="sr-only">
                              Close details for {project.data.title}
                            </span>
                          </>
                        </span>
                        <svg
                          class="info-orb fluid-ink"
                          viewBox="0 0 44 44"
                          aria-hidden="true"
                        >
                          <g>
                            <circle cx="22" cy="22" r="20" />
                          </g>
                        </svg>
                      </summary>
                      <svg class="info-ink fluid-ink" aria-hidden="true">
                        <g>
                          <rect rx="18" />
                        </g>
                      </svg>
                      <div
                        class="work-more-body"
                        id={`info-${id}`}
                        role="region"
                        tabindex="0"
                        aria-labelledby={`info-title-${id}`}
                      >
                        <h4 id={`info-title-${id}`}>
                          Inside {project.data.title}
                        </h4>
                        <ul>
                          {[...how, hook].map((line) => (
                            <li>{line}</li>
                          ))}
                        </ul>
                        <p class="work-contribution">{contribution}</p>
                      </div>
                    </details>
                    <div class="work-foot">
                      <a class="work-read" href={`/projects/${id}/`}>
                        Read project
                        <span class="sr-only"> {project.data.title}</span>
                      </a>
                    </div>
                  </div>
                </article>
              ),
            )
          }
        </div>
      </section>

      <section
        class="background wrap"
        id="background"
        aria-labelledby="background-title"
      >
        <div class="section-heading">
          <h2 id="background-title">Background</h2>
          <a href="/files/resume.pdf">Résumé</a>
        </div>
        <div class="journey">
          <div class="journey-content">
            <div
              class="timeline-tabs glass"
              role="tablist"
              aria-label="Background timeline"
              hidden
            >
              <span class="timeline-tab-indicator" aria-hidden="true"></span>
              <button
                type="button"
                role="tab"
                id="tab-experience"
                aria-controls="panel-experience"
                aria-selected="true"
                data-timeline="experience"
                ><Icon name="briefcase" />Experience</button
              >
              <button
                type="button"
                role="tab"
                id="tab-education"
                aria-controls="panel-education"
                aria-selected="false"
                tabindex="-1"
                data-timeline="education"
                ><Icon name="graduation-cap" />Education</button
              >
            </div>
            <p class="timeline-hint" aria-hidden="true">
              <span class="hint-pointer">Click</span><span class="hint-touch"
                >Tap</span
              > to expand
            </p>
            <div class="timeline-stage">
              {
                [
                  ["experience", experience],
                  ["education", education],
                ].map(([kind, items]) => (
                  <div
                    class:list={[
                      "timeline-panel",
                      { "is-active": kind === "experience" },
                    ]}
                    id={`panel-${kind}`}
                    role="tabpanel"
                    aria-labelledby={`tab-${kind}`}
                    tabindex="0"
                  >
                    <h3 class="timeline-fallback-heading">
                      {kind === "experience" ? "Experience" : "Education"}
                    </h3>
                    <ol class="career-track">
                      {items.map((item) => (
                        <li
                          class:list={[
                            "career-stop",
                            { "is-current": item.current },
                          ]}
                        >
                          <div class="career-date">
                            <time>{item.year}</time>
                          </div>
                          <div class="career-marker" aria-hidden="true">
                            <span class="career-segment" />
                            <span class="career-node" />
                          </div>
                          <details class="career-card glass">
                            <summary class="career-summary">
                              <span
                                class:list={[
                                  "org-icon",
                                  {
                                    "org-wordmark":
                                      item.logo?.includes("rj.svg") ||
                                      item.logo?.includes("slice.webp"),
                                  },
                                ]}
                              >
                                {item.logo ? (
                                  <img
                                    src={item.logo}
                                    width="32"
                                    height="32"
                                    alt=""
                                    loading="eager"
                                  />
                                ) : (
                                  <Icon name={item.icon} />
                                )}
                              </span>
                              <span class="career-org">
                                {item.org}
                                {item.current && (
                                  <span class="current-label">Current</span>
                                )}
                              </span>
                              <h3 class="career-role">{item.role}</h3>
                              <p class="career-period">
                                {item.when}
                                {item.mark && (
                                  <span class="gpa">{item.mark}</span>
                                )}
                              </p>
                            </summary>
                            <div class="career-description">
                              <div class="career-description-inner">
                                <p>{item.description}</p>
                              </div>
                            </div>
                          </details>
                        </li>
                      ))}
                    </ol>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="index wrap" id="projects" aria-labelledby="index-title">
        <div class="section-heading">
          <h2 id="index-title">All projects</h2>
          <p id="result-count" role="status" aria-live="polite">
            {raw.length} projects
          </p>
        </div>
        <span id="all-projects" aria-hidden="true"></span>
        <div class="filters" hidden>
          <div class="search-box">
            <div class="search-row">
              <label class="search-label glass"
                ><Icon name="search" /><span class="sr-only"
                  >Search projects and tools</span
                >
                <input
                  id="project-search"
                  type="search"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="tool-suggestions"
                  autocomplete="off"
                  placeholder="Search projects or tools"
                />
              </label>
              <button
                type="button"
                class="filter-toggle glass"
                aria-expanded="false"
                aria-controls="filter-panel"
                ><Icon name="sliders" /><span class="filter-toggle-label"
                  >Filters</span
                ><span class="filter-dot" aria-hidden="true" hidden></span><span
                  class="sr-only filter-state"></span></button
              >
            </div>
            <ul
              id="tool-suggestions"
              class="tool-suggestions glass-float"
              role="listbox"
              aria-label="Suggested tools"
              hidden
            >
            </ul>
          </div>
          <div class="filter-scroll-shell" id="filter-panel" hidden>
            <div class="filter-chips" role="group" aria-label="Filter projects">
              {
                facets.map(([id, label]) => (
                  <button
                    type="button"
                    data-filter={id}
                    aria-pressed={id === "all" ? "true" : "false"}
                  >
                    <Icon name={facetIcons[id]} />
                    {label}
                  </button>
                ))
              }
            </div>
            <button
              type="button"
              class="filter-scroll-more"
              aria-label="Show more filters"
              hidden><span aria-hidden="true">›</span></button
            >
          </div>
          <div
            id="active-search-filters"
            class="active-search-filters"
            role="group"
            aria-label="Active search filters"
            hidden
          >
          </div>
          <button type="button" id="reset-filters" hidden>Reset filters</button>
        </div>
        <div class="project-list glass">
          {
            [recent, earlier].map((group, groupIndex) => (
              <>
                {groupIndex === 1 && (
                  <h3 class="list-divider" id="earlier-work" data-list-divider>
                    Earlier work
                    <span>Coursework and early personal projects</span>
                  </h3>
                )}
                {group.map((p) => (
                  <article
                    class="project-row"
                    data-category={p.data.category}
                    data-tools={JSON.stringify(p.data.tools)}
                    data-facets={(capabilities[p.id] || []).join(" ")}
                    data-search={`${p.data.title} ${p.data.summary} ${p.data.tools.join(" ")}`.toLowerCase()}
                  >
                    <a class="project-row-link" href={`/projects/${p.id}/`}>
                      <span class="row-icon" aria-hidden="true">
                        <Icon
                          name={
                            projectIcons[p.id] ||
                            facetIcons[(capabilities[p.id] || ["web"])[0]]
                          }
                        />
                      </span>
                      <span class="row-main">
                        <h3>{p.data.title}</h3>
                        <p>{p.data.summary}</p>
                      </span>
                      <span class="row-meta">
                        <span class="card-category">{p.data.status}</span>
                        <span class="card-tools">
                          {p.data.tools.slice(0, 4).map((tool) => (
                            <ToolIcon tool={tool} size={15} />
                          ))}
                        </span>
                      </span>
                    </a>
                  </article>
                ))}
              </>
            ))
          }
          <p id="empty-results" hidden>
            No projects match. <button type="button" id="clear-filters"
              >Clear filters</button
            >
          </p>
        </div>
      </section>

      <section
        class="contact wrap"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="contact-card glass">
          <div class="contact-copy">
            <h2 id="contact-title">Contact</h2>
            <p>Reach me by email.</p>
          </div>
          <div class="contact-actions">
            <a class="btn btn-primary" href="mailto:petrozzi@usf.edu"
              ><Icon name="mail" />Email me</a
            >
            <button
              type="button"
              class="btn copy-email"
              data-email="petrozzi@usf.edu"
              hidden
              ><Icon name="copy" /><span class="copy-label">Copy email</span
              ></button
            >
            <span
              class="sr-only"
              role="status"
              aria-live="polite"
              id="copy-status"></span>
          </div>
          <ul class="contact-links" aria-label="Profiles">
            <li>
              <a
                class="btn btn-quiet"
                href="https://www.linkedin.com/in/fabriziopetrozzi/"
                ><Icon name="linkedin" />LinkedIn</a
              >
            </li>
            <li>
              <a class="btn btn-quiet" href="https://github.com/f-petrozzi"
                ><Icon name="github" />GitHub</a
              >
            </li>
            <li>
              <a class="btn btn-quiet" href="/files/resume.pdf"
                ><Icon name="file-text" />Résumé</a
              >
            </li>
          </ul>
        </div>
      </section>
      <footer class="footer wrap">
        <span>Fabrizio Petrozzi</span>
        <a href="/classic/" data-era-link class="era-switch">2023 portfolio</a>
        <span>© {new Date().getFullYear()}</span>
      </footer>
    </main>
    <ImageViewer />
    <QuickPreview />
    <span id="era-ready" hidden></span>
    <script>
      import "../scripts/home";
    </script>
  </body>
</html>
