---
import "../styles/tokens.css";
import "../styles/global.css";
import ScrollControl from "../components/ScrollControl.astro";
import SiteHeader from "../components/SiteHeader.astro";
const {
  title = "Fabrizio Petrozzi | Projects",
  description = "Software, AI, and data projects by Fabrizio Petrozzi in St. Petersburg, Florida.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0f18" />
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/fonts/fonts.css" />
    <link
      rel="preload"
      href="/assets/fonts/instrument-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/era.css" />
    <link rel="expect" href="#era-ready" blocking="render" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("portfolio-theme") === "light"
            ? "light"
            : "dark";
      } catch {}
    </script>
    <script src="/era.js" is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="project-fields" aria-hidden="true">
      <div class="field project-field-cyan"></div>
      <div class="field project-field-violet"></div>
    </div>
    <SiteHeader />
    <ScrollControl />
    <slot />
    <footer class="wrap">
      <a href="/" class="footer-name">Fabrizio Petrozzi</a>
      <div>
        <a href="https://github.com/f-petrozzi">GitHub</a><a
          href="https://www.linkedin.com/in/fabriziopetrozzi/">LinkedIn</a
        ><a href="/files/resume.pdf">Résumé</a>
      </div>
      <span class="copyright">© {new Date().getFullYear()}</span>
    </footer>
    <span id="era-ready" hidden></span>
  </body>
</html>
