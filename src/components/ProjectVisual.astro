---
const { kind, title } = Astro.props;
---

<div class:list={["project-art", kind]} aria-hidden="true">
  {
    kind === "nume" ? (
      <div class="system-preview">
        <div class="preview-title">NüMe</div>
        <div class="agent-flow">
          <div class="flow-inputs">
            <>
              <span>Sleep</span>
              <span>Activity</span>
              <span>Check-ins</span>
            </>
          </div>
          <div class="flow-connector" />
          <div class="flow-coordinator">Coordinator agent</div>
          <div class="flow-connector" />
          <div class="flow-inputs">
            <>
              <span>Student specialist</span>
              <span>Caregiver specialist</span>
            </>
          </div>
          <div class="flow-connector" />
          <div class="flow-result">Validated support plan</div>
        </div>
        <span class="preview-note">How the agents connect</span>
      </div>
    ) : kind === "proterra" ? (
      <div class="publication-preview">
        <div class="preview-title">
          Proterra
          <br />
          Intelligence
        </div>
        <p>Dairy. Meat. Bovine genetics.</p>
        <ol>
          <>
            <li>Collect sources</li>
            <li>Draft the brief</li>
            <li>Review the evidence</li>
            <li>Approve publication</li>
          </>
        </ol>
        <span class="preview-note">The editorial workflow</span>
      </div>
    ) : kind === "nest" ? (
      <div class="nest-preview">
        <div class="preview-title">Nest</div>
        <div class="room-grid">
          <>
            <span>Weekly plans</span>
            <span>Recipes</span>
            <span>Pantry</span>
            <span>Groceries</span>
            <span>Cat care</span>
            <span>Calendar</span>
          </>
        </div>
        <span class="preview-note">What lives in the household app</span>
      </div>
    ) : (
      <div class="small-art">
        <strong>{title}</strong>
      </div>
    )
  }
</div>
