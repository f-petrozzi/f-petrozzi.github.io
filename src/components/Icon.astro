---
import { readFileSync, existsSync } from "node:fs";
const { name, class: className = "" } = Astro.props;
const extra = {
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/>',
  close: '<path d="m6 6 12 12M6 18 18 6"/>',
  audio:
    '<rect x="8" y="2" width="8" height="14" rx="4"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/>',
  home: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-8H9v8H4a1 1 0 0 1-1-1z"/>',
  book: '<path d="M12 5v16M3 3c4 0 7 0 9 2 2-2 5-2 9-2v16c-4 0-7 0-9 2-2-2-5-2-9-2z"/>',
  pizza:
    '<path d="M12 3 3 21h18L12 3ZM7 14c3-2 7-2 10 0"/><circle cx="11" cy="11" r=".7"/><circle cx="13" cy="17" r=".7"/>',
};
const file = `src/icons/${name}.svg`;
const raw = existsSync(file) ? readFileSync(file, "utf8") : "";
const body =
  extra[name] ||
  (raw
    ? raw.slice(raw.indexOf(">", raw.indexOf("<svg")) + 1).replace("</svg>", "")
    : extra.grid);
---

<svg
  class={`ui-icon ${className}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
