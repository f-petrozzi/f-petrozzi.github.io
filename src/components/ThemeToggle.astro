<button class="theme-toggle" aria-label="Switch theme" hidden>
  <svg
    class="theme-icon"
    width="22"
    height="22"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <defs
      ><mask id="theme-moon-mask"
        ><rect width="24" height="24" fill="white"></rect><circle
          class="theme-cutout"
          cx="24"
          cy="0"
          r="5.5"
          fill="black"></circle></mask
      ></defs
    >
    <circle
      class="theme-disc"
      cx="12"
      cy="12"
      r="5"
      fill="currentColor"
      mask="url(#theme-moon-mask)"></circle>
    <g
      class="theme-rays"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    >
      <path
        d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6 19 19M5 19l1.4-1.4M17.6 6.4 19 5"
      ></path>
    </g>
  </svg>
</button>
<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    padding: 0;
  }
  .theme-icon {
    overflow: visible;
  }
  .theme-disc,
  .theme-rays {
    transform-origin: 12px 12px;
    transition:
      transform 450ms ease,
      opacity 300ms ease;
  }
  .theme-cutout {
    transition: transform 450ms ease;
  }
  :global(html:not([data-theme="light"])) .theme-disc {
    transform: scale(1.5);
  }
  :global(html:not([data-theme="light"])) .theme-cutout {
    transform: translate(-10px, 9px);
  }
  :global(html:not([data-theme="light"])) .theme-rays {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-disc,
    .theme-rays,
    .theme-cutout {
      transition: none;
    }
  }
</style>
<script>
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
  const root = document.documentElement;
  const update = () => {
    button.setAttribute(
      "aria-label",
      `Switch to ${root.dataset.theme === "light" ? "dark" : "light"} theme`,
    );
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute(
        "content",
        root.dataset.theme === "light" ? "#f2f5fa" : "#0d1422",
      );
  };
  update();
  button.hidden = false;
  button.addEventListener("click", () => {
    root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
    try {
      localStorage.setItem("portfolio-theme", root.dataset.theme);
    } catch {}
    update();
  });
</script>
