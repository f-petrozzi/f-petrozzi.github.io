---
import ScrollDroplet from "./ScrollDroplet.astro";
import "../styles/scroll-control.css";
const { controls = "main" } = Astro.props;
---

<aside class="scroll-rail" aria-label="Page scroll" hidden>
  <div class="scroll-track" aria-hidden="true"></div>
  <div
    class="scroll-thumb"
    role="scrollbar"
    tabindex="0"
    aria-label="Page scroll"
    aria-controls={controls}
    aria-orientation="vertical"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-valuetext="Top of page"
    title="Drag or use arrow keys, Page Up, Page Down, Home or End."
  >
    <ScrollDroplet />
  </div>
</aside>

<script>
  import "../scripts/scroll-control";
</script>
