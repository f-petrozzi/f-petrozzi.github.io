---
import {
  activityGrid,
  localDate,
  type ActivityExport,
} from "../lib/agent-activity";

// A missing export and the checked-in empty placeholder both render nothing.
const exports = import.meta.glob<ActivityExport>(
  "../data/agent-activity.json",
  {
    eager: true,
    import: "default",
  },
);
const source = Object.values(exports)[0];
const grid =
  source?.schemaVersion === 1 && source.days?.length
    ? activityGrid(source.days, localDate(source.generatedAt, source.timezone))
    : null;
const numbers = new Intl.NumberFormat("en-US");
const month = new Intl.DateTimeFormat("en-US", {
  month: "short",
  timeZone: "UTC",
});
const shortDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const date = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const asDate = (key: string) => new Date(`${key}T00:00:00Z`);
const prompts = (count: number) =>
  `${numbers.format(count)} ${count === 1 ? "prompt" : "prompts"}`;
const label = (day: { date: string; count: number }) =>
  `${shortDate.format(asDate(day.date))}, ${prompts(day.count)}`;
---

{
  grid && (
    <section
      class="activity-grid"
      aria-labelledby="activity-title"
      data-activity
    >
      <header>
        <h2 id="activity-title">Building with agents</h2>
        <p id="activity-summary">
          <strong>{numbers.format(grid.yearTotal)}</strong>
          <span>
            {`${grid.yearTotal === 1 ? "prompt" : "prompts"} across ${numbers.format(grid.yearActiveDays)} ${grid.yearActiveDays === 1 ? "day" : "days"} this year`}
          </span>
        </p>
        <p class="activity-hint">Tap or slide to see daily counts.</p>
      </header>
      <div
        class="activity-band"
        tabindex="0"
        role="group"
        aria-label="Daily agent prompts"
        aria-describedby="activity-instructions"
      >
        <span id="activity-instructions" class="sr-only">
          Use up and down arrows to move by day, left and right arrows to move
          by week, and Home or End for the first or last visible day. Press
          Escape to dismiss the count.
        </span>
        <div class="activity-chart" aria-hidden="true">
          {grid.weeks.map((week, column) => {
            const monthDay = week.find(
              (day) => !day.future && day.date.endsWith("-01"),
            );
            // Leave room for the month name at the right edge.
            const monthLabel =
              column < 52
                ? (monthDay ?? (column === 0 ? week[0] : null))
                : null;
            return (
              <div class="activity-week" data-activity-column>
                <span class="activity-month">
                  {monthLabel ? month.format(asDate(monthLabel.date)) : ""}
                </span>
                {week.map((day) => (
                  <span
                    class="activity-cell"
                    data-level={day.level}
                    data-future={day.future || undefined}
                    data-tooltip={day.future ? undefined : label(day)}
                  />
                ))}
              </div>
            );
          })}
        </div>
        <div class="activity-tooltip" data-activity-tooltip aria-hidden="true">
          <span />
        </div>
        <span
          class="sr-only"
          data-activity-selection
          role="status"
          aria-live="polite"
          aria-atomic="true"
        />
      </div>
      <div class="activity-values">
        <table>
          <caption>
            Daily agent prompts through{" "}
            {date.format(asDate(grid.days.at(-1)!.date))}. Dates use{" "}
            {source.timezone}. The desktop chart shows 53 weeks. Narrow screens
            show the most recent weeks. Color intensity indicates prompt count.
          </caption>
          <thead>
            <tr>
              <th scope="col">Day</th>
              <th scope="col">Prompts</th>
            </tr>
          </thead>
          <tbody>
            {grid.days.toReversed().map((day) => (
              <tr>
                <th scope="row">
                  <time datetime={day.date}>
                    {date.format(asDate(day.date))}
                  </time>
                </th>
                <td>{numbers.format(day.count)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
<style is:inline>
  .activity-grid {
    --activity-0: hsl(196 40% 55% / 0.09);
    --activity-1: hsl(196 40% 39%);
    --activity-2: hsl(196 49% 49%);
    --activity-3: hsl(196 64% 61%);
    --activity-4: hsl(196 79% 75%);
    --activity-tip-bg: #172333;
    --activity-tip-ink: #eef3f8;
    --activity-weeks: 53;
    display: grid;
    grid-template-columns: minmax(150px, 200px) minmax(0, 1fr);
    column-gap: 40px;
    align-items: end;
    min-width: 0;
    margin-top: 56px;
    font-size: 13px;
    font-variant-numeric: tabular-nums;

    & header {
      padding-bottom: 2px;
    }
    & h2 {
      margin: 0 0 2px;
      color: inherit;
      opacity: 0.7;
      font-size: 12px;
      font-weight: 500;
      line-height: 1.5;
    }
    & p {
      margin: 0;
      color: inherit;
      font-size: 13px;
      line-height: 1.5;
      text-wrap: pretty;
    }
    & p strong {
      display: block;
      margin: 6px 0 2px;
      font-size: clamp(28px, 2.6vw, 36px);
      font-weight: 500;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: inherit;
    }
    & p span {
      opacity: 0.7;
    }
    .activity-band {
      position: relative;
      width: 100%;
      min-width: 0;
      container-type: inline-size;
      /* Horizontal exploration leaves vertical page scrolling and zoom native. */
      touch-action: pan-y pinch-zoom;
      user-select: none;
      -webkit-user-select: none;
    }
    .activity-hint {
      display: none;
      margin-top: 8px;
      font-size: 12px;
      color: inherit;
      opacity: 0.7;
    }
    @media (any-pointer: coarse) {
      .activity-hint {
        display: block;
      }
    }
    &:has(.activity-tooltip[data-open]) .activity-hint {
      visibility: hidden;
    }
    .activity-chart {
      display: grid;
      grid-template-columns: repeat(var(--activity-weeks), minmax(0, 1fr));
      gap: 3px;
    }
    .activity-week {
      display: grid;
      /* Month labels may overflow, but must never widen the cell column. */
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 16px repeat(7, auto);
      gap: 3px;
      min-width: 0;
    }
    .activity-month {
      color: inherit;
      opacity: 0.7;
      font-size: 10px;
      line-height: 1;
      white-space: nowrap;
    }
    .activity-cell {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      border-radius: 3px;
      background: var(--activity-0);
    }
    .activity-cell[data-selected] {
      border: 1.5px solid var(--activity-4);
    }
    [data-level="1"] {
      background: var(--activity-1);
    }
    [data-level="2"] {
      background: var(--activity-2);
    }
    [data-level="3"] {
      background: var(--activity-3);
    }
    [data-level="4"] {
      background: var(--activity-4);
    }
    [data-future] {
      visibility: hidden;
    }
    .activity-tooltip {
      position: absolute;
      z-index: 5;
      width: 180px;
      max-width: 100%;
      padding-bottom: 6px;
      opacity: 0;
      pointer-events: none;
      transform: translateY(calc(-100% + 3px));
      transition:
        opacity 125ms cubic-bezier(0.23, 1, 0.32, 1),
        transform 125ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .activity-tooltip span {
      display: block;
      padding: 5px 8px;
      border-radius: 5px;
      background: var(--activity-tip-bg);
      color: var(--activity-tip-ink);
      font-size: 12px;
      line-height: 1.5;
      text-align: center;
    }
    .activity-tooltip[data-open] {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(-100%);
    }
    .activity-values {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    @media (max-width: 767px) {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 14px;
      margin-top: 40px;
    }
    @container (width < 720px) {
      .activity-chart {
        --activity-weeks: 36;
      }
      .activity-week:nth-child(-n + 17) {
        display: none;
      }
    }
    @container (width < 480px) {
      .activity-chart {
        --activity-weeks: 26;
      }
      .activity-week:nth-child(-n + 27) {
        display: none;
      }
    }
    @container (width < 340px) {
      .activity-chart {
        --activity-weeks: 18;
      }
      .activity-week:nth-child(-n + 35) {
        display: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .activity-tooltip {
        transition: none;
        transform: translateY(-100%);
      }
    }
    @media (forced-colors: active) {
      .activity-cell {
        border: 1px solid CanvasText;
      }
      [data-level="0"] {
        opacity: 0.25;
      }
    }
  }
</style>
<script>
  import "../scripts/agent-activity";
</script>
