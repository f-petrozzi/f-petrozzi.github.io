---
import {
  collectItems,
  issue,
  publications,
  storyImages,
} from "../../data/demos/proterra";
const results = collectItems();
const sources = results.filter((result) => result.accepted);
const instance = `proterra-${crypto.randomUUID()}`;
---

<section
  class="demo demo-proterra"
  data-demo="proterra"
  aria-label="Proterra Intelligence interactive sample"
>
  <header class="toolbar">
    <div class="brand">
      <img
        src="/assets/demos/proterra/logo.svg"
        width="40"
        height="40"
        alt=""
      />
      <div>
        <strong>Proterra Intelligence</strong><span
          >Agricultural intelligence</span
        >
      </div>
    </div>
    <button type="button" data-reset>Reset</button>
  </header>
  <nav class="stages" aria-label="Weekly brief pipeline">
    {
      ["Sources", "Draft", "Review", "Publish"].map((stage, i) => (
        <button
          type="button"
          data-stage={i}
          aria-current={i === 0 ? "step" : undefined}
          disabled={i > 0}
        >
          <span>0{i + 1}</span>
          {stage}
          <small data-step-status={i}>
            {i === 0 ? "Collected" : "Pending"}
          </small>
        </button>
      ))
    }
  </nav>
  <div class="workspace">
    <section
      data-panel="0"
      aria-label="This week’s collected sources"
      tabindex="0"
    >
      <div class="heading">
        <div>
          <p class="kicker">Weekly collection / 12 October 2026</p>
          <h2>This week</h2>
          <p class="muted">3 stories collected from approved publications</p>
        </div>
        <button type="button" class="primary" data-create>Create draft ↗</button
        >
      </div>
      <div class="story-grid">
        {
          sources.map(({ item }, i) => {
            const image = storyImages[item.id as keyof typeof storyImages];
            return (
              <article class:list={["story-card", { "lead-story": i === 0 }]}>
                <figure>
                  <img
                    src={image.src}
                    alt={image.alt}
                    width="480"
                    height="270"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption
                    title={`${image.alt}. ${image.author}. ${image.license}. ${image.source}. Resized and cropped.`}
                  >
                    Photo: {image.author} / {image.license}
                  </figcaption>
                </figure>
                <div class="story-copy">
                  <div class="news-meta">
                    <>
                      <span>{item.publication}</span>
                      <time datetime={item.date}>
                        {item.date.slice(8)} October
                      </time>
                    </>
                  </div>
                  <h3>{item.title}</h3>
                  <span class="sector">{item.sector}</span>
                  <details>
                    <summary>Source passage ↗</summary>
                    <p>{item.excerpt}</p>
                    <code>{item.url}</code>
                  </details>
                </div>
              </article>
            );
          })
        }
      </div>
      <details class="collection-audit">
        <summary>Collection record / 7 discovered, 3 kept, 4 filtered</summary>
        <p class="muted">Coverage: 5 to 11 October 2026</p>
        <div class="allow-list">
          <p class="kicker">Approved publications</p>
          {
            publications.map((publisher) => (
              <div>
                <>
                  <strong>{publisher.name}</strong>
                  <span>{publisher.host}</span>
                </>
              </div>
            ))
          }
        </div>
        <ul class="audit">
          {
            results.map(({ item, accepted, reason }) => (
              <li>
                <span class:list={["decision", { kept: accepted }]}>
                  {accepted ? "Kept" : "Filtered"}
                </span>
                <div>
                  <>
                    <strong>{item.title}</strong>
                    <span>{item.publication}</span>
                    <p>{reason.replace(/^(Kept|Filtered): /, "")}</p>
                  </>
                </div>
              </li>
            ))
          }
        </ul>
      </details>
    </section>

    <section data-panel="1" hidden tabindex="0" aria-label="Draft and evidence">
      <div class="heading">
        <div>
          <p class="kicker">Draft preview</p><h2 data-draft-title>
            {issue.title}
          </h2><p class="muted">Dairy / beef / bovine genetics</p>
        </div><button type="button" class="primary" data-review
          >Review draft ↗</button
        >
      </div>
      <div class="evidence-layout">
        <div class="claims">
          <h3>Reported facts</h3>
          {
            sources.map(({ item }, i) => (
              <article class="claim" data-claim-card={item.id}>
                <span class="kicker">
                  0{i + 1} / {item.sector}
                </span>
                <button
                  type="button"
                  data-claim={item.id}
                  aria-pressed={i === 0 ? "true" : "false"}
                  aria-controls={`${instance}-${item.id}`}
                >
                  {item.claim}
                </button>
                <a href={`#${instance}-${item.id}`} data-source-link={item.id}>
                  Source passage ↗
                </a>
              </article>
            ))
          }
        </div>
        <aside class="evidence" aria-label="Supporting source passages">
          <h3>Source passage</h3>
          {
            sources.map(({ item }, i) => (
              <article
                id={`${instance}-${item.id}`}
                data-excerpt={item.id}
                data-selected={i === 0 ? "true" : "false"}
                hidden={i !== 0}
              >
                <>
                  <p class="kicker">{item.publication}</p>
                  <h4>{item.title}</h4>
                </>
                <blockquote>
                  <mark>{item.excerpt}</mark>
                </blockquote>
                <code>{item.url}</code>
              </article>
            ))
          }
        </aside>
      </div>
    </section>

    <section
      data-panel="2"
      hidden
      tabindex="0"
      aria-label="Review current draft"
    >
      <div class="heading">
        <div>
          <p class="kicker">Review snapshot</p><h2>Approve this version</h2>
        </div><div class="fingerprint">
          <span>Version fingerprint</span><code data-fingerprint></code>
        </div>
      </div>
      <div class="review-layout">
        <div class="review-copy">
          <label
            >Brief title<input
              type="text"
              value={issue.title}
              maxlength="120"
              data-title
              autocomplete="off"
            /></label
          >
          <ol>
            {
              sources.map(({ item }) => (
                <li>
                  <>
                    <strong>{item.sector}</strong>
                    <p>{item.claim}</p>
                    <button
                      type="button"
                      class="text-button"
                      data-review-source={item.id}
                    >
                      Inspect source passage ↗
                    </button>
                  </>
                </li>
              ))
            }
          </ol>
          <label
            >Editorial note<textarea rows="3" maxlength="280" data-note
              >Public industry sources only.</textarea
            ></label
          >
        </div>
        <aside class="review-gate">
          <p class="kicker">Publication checks</p>
          <p data-validation></p>
          <div class="approval" data-approval-box>
            <strong data-approval-label>Awaiting approval</strong><p
              data-approval-copy
            >
            </p>
          </div>
          <button type="button" class="primary" data-approve
            >Approve this version</button
          >
          <button type="button" data-open-publish>Continue to publish ↗</button>
        </aside>
      </div>
    </section>

    <section
      data-panel="3"
      hidden
      tabindex="0"
      aria-label="Publish website and email"
    >
      <div class="heading">
        <div>
          <p class="kicker">Website + weekly email</p><h2 data-publish-heading>
            Ready for publication
          </h2><p class="muted" data-publish-version></p>
        </div><button type="button" class="primary" data-publish
          >Publish brief</button
        >
      </div>
      <p class="publish-gate" data-publish-gate></p>
      <div class="previews" data-previews hidden>
        <article class="website-preview">
          <p class="kicker">Website updated</p><div class="preview-brand">
            Proterra Intelligence
          </div><span class="muted">Weekly Brief / 12 October 2026</span><h3
            data-website-title
          >
          </h3><p data-website-note></p><ul>
            {
              sources.map(({ item }) => (
                <li>
                  <>
                    <strong>{item.sector}</strong>
                    <p data-published-claim={item.id}>{item.claim}</p>
                  </>
                </li>
              ))
            }
          </ul><code>https://proterra.example.com/reports/2026-10-12</code>
        </article>
        <article class="email-preview">
          <p class="kicker">Email preview</p><dl>
            <div><dt>From</dt><dd>Proterra Intelligence</dd></div><div>
              <dt>To</dt><dd>Weekly brief subscribers</dd>
            </div><div><dt>Subject</dt><dd data-email-title></dd></div>
          </dl><div class="email-body">
            <p class="kicker">Your weekly agricultural brief</p><h3
              data-email-heading
            >
            </h3><p data-email-note></p>{
              sources.map(({ item }) => (
                <div class="email-story">
                  <p class="kicker">{item.sector}</p>
                  <p data-published-claim={item.id}>{item.claim}</p>
                </div>
              ))
            }<span class="email-cta">Read the full brief ↗</span><code
              >https://proterra.example.com/reports/2026-10-12</code
            ><span class="unsubscribe">Unsubscribe</span>
          </div>
        </article>
      </div>
    </section>
    <p class="status" role="status" aria-live="polite" data-status>
      This week’s collection is ready: 3 stories from approved publications.
    </p>
    <p class="simulation">
      Codex drafts the real brief; drafting is simulated here.
    </p>
    <noscript><p>JavaScript is needed for this pipeline.</p></noscript>
  </div>
</section>

<script>
  import "../../scripts/demos/proterra";
</script>

<style is:inline>
  .demo-proterra {
    --proterra-paper: #f4f3ed;
    --proterra-surface: #fafaf6;
    --proterra-ink: #17201c;
    --proterra-muted: #5e6963;
    --proterra-line: #d3d6cd;
    --proterra-forest: #173f32;
    --proterra-deep: #0c2c22;
    --proterra-mint: #b7d7c1;
    --proterra-soft: #e9e9e1;
    color-scheme: light;
    margin: 28px 0;
    border: 1px solid var(--proterra-line);
    border-radius: 2px;
    background: var(--proterra-paper);
    color: var(--proterra-ink);
    overflow: hidden;
    font-size: 14px;
    line-height: 1.5;

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }
    [hidden] {
      display: none !important;
    }
    :is(button, a, input, textarea, summary) {
      touch-action: manipulation;
    }
    :is(
      button,
      a,
      input,
      textarea,
      summary,
      h2,
      [data-excerpt],
      [data-panel]
    ):focus-visible {
      outline: 2px solid var(--proterra-forest);
      outline-offset: 3px;
      box-shadow: none;
    }
    button {
      min-height: 44px;
      padding: 10px 14px;
      border: 1px solid var(--proterra-line);
      border-radius: 2px;
      background: var(--proterra-surface);
      color: var(--proterra-forest);
      font: inherit;
      cursor: pointer;
    }
    button:disabled {
      color: var(--proterra-muted);
      cursor: default;
    }
    button:not(:disabled):active {
      transform: scale(0.98);
    }
    .primary {
      background: var(--proterra-forest);
      color: var(--proterra-surface);
      border-color: var(--proterra-forest);
      font-weight: 600;
    }
    .primary:disabled {
      background: var(--proterra-soft);
      border-color: var(--proterra-line);
    }
    :is(.toolbar, .heading, .section-line) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px 20px;
      flex-wrap: wrap;
    }
    .toolbar {
      padding: 16px 24px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }
    .brand img {
      flex: 0 0 40px;
    }
    .brand div {
      display: grid;
    }
    .brand strong {
      font-size: 16px;
      font-weight: 600;
      letter-spacing: -0.03em;
    }
    .brand span {
      font-size: 10px;
      color: var(--proterra-muted);
    }
    .stages {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 4px;
      padding: 8px 24px;
      border-block: 1px solid var(--proterra-line);
    }
    .stages button {
      text-align: left;
      padding: 8px 12px;
      background: transparent;
      border-color: transparent;
    }
    .stages button[aria-current] {
      border-color: var(--proterra-forest);
      background: var(--proterra-surface);
    }
    .stages span {
      font-size: 10px;
      margin-right: 6px;
    }
    .stages small {
      display: block;
      color: var(--proterra-muted);
      font-size: 10px;
      margin-top: 3px;
    }
    [data-panel] {
      height: 450px;
      overflow: auto;
      overscroll-behavior: contain;
      padding: 24px;
    }
    :is([data-panel], textarea) {
      scrollbar-width: thin;
      scrollbar-color: var(--proterra-muted) transparent;
    }
    :is([data-panel], textarea)::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    :is([data-panel], textarea)::-webkit-scrollbar-track {
      background: transparent;
    }
    :is([data-panel], textarea)::-webkit-scrollbar-thumb {
      background: var(--proterra-muted);
      border-radius: 6px;
    }
    .heading {
      margin-bottom: 20px;
    }
    :is(h2, h3, h4) {
      color: inherit;
      font-family: inherit;
      letter-spacing: -0.035em;
      font-weight: 550;
      overflow-wrap: anywhere;
    }
    h2 {
      margin: 4px 0;
      font-size: clamp(24px, 3vw, 32px);
      line-height: 1.1;
    }
    h3 {
      margin: 0 0 12px;
      font-size: 17px;
      line-height: 1.2;
    }
    h4 {
      margin: 8px 0;
      font-size: 16px;
      line-height: 1.3;
    }
    p {
      margin: 6px 0;
    }
    .muted {
      color: var(--proterra-muted);
      font-size: 12px;
    }
    .kicker {
      color: var(--proterra-forest);
      font-size: 10px;
      font-weight: 650;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }
    .story-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 12px;
      align-items: start;
    }
    .story-card {
      min-width: 0;
      border: 1px solid var(--proterra-line);
      border-radius: 2px;
      background: var(--proterra-surface);
      overflow: hidden;
    }
    .story-card:not(.lead-story) {
      display: grid;
      grid-template-columns: 32% minmax(0, 1fr);
    }
    .lead-story {
      grid-row: span 2;
      background: var(--proterra-deep);
      color: var(--proterra-surface);
      border-color: var(--proterra-deep);
    }
    figure {
      margin: 0;
      position: relative;
      min-width: 0;
    }
    figure img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .lead-story figure {
      height: 150px;
    }
    figcaption {
      position: absolute;
      bottom: 5px;
      right: 5px;
      left: 5px;
      padding: 3px 5px;
      background: var(--proterra-deep);
      color: var(--proterra-surface);
      font-size: 8px;
      line-height: 1.4;
    }
    .story-copy {
      padding: 14px;
      min-width: 0;
    }
    .news-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 12px;
      font-size: 10px;
      color: var(--proterra-muted);
    }
    .news-meta span {
      font-weight: 650;
      color: var(--proterra-forest);
    }
    .story-copy h3 {
      margin: 8px 0;
      font-size: 17px;
    }
    .lead-story h3 {
      font-size: clamp(20px, 2.2vw, 26px);
    }
    .lead-story :is(.news-meta, .news-meta span, .sector, summary) {
      color: var(--proterra-mint);
    }
    .sector {
      display: inline-block;
      font-size: 10px;
      color: var(--proterra-forest);
    }
    summary {
      min-height: 44px;
      align-content: center;
      cursor: pointer;
      color: var(--proterra-forest);
      font-size: 12px;
      font-weight: 550;
    }
    details p {
      font-size: 12px;
    }
    .story-copy details code {
      color: inherit;
    }
    .collection-audit {
      margin-top: 20px;
      border-top: 1px solid var(--proterra-line);
    }
    .allow-list {
      padding: 12px 0;
    }
    .allow-list > div {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 12px;
      font-size: 12px;
    }
    .allow-list span {
      color: var(--proterra-muted);
    }
    .audit {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .audit li {
      display: grid;
      grid-template-columns: 60px minmax(0, 1fr);
      gap: 14px;
      padding: 12px 0;
      border-top: 1px solid var(--proterra-line);
    }
    .audit strong,
    .audit div > span {
      display: block;
      font-size: 12px;
    }
    .audit p,
    .audit div > span {
      font-size: 11px;
      color: var(--proterra-muted);
    }
    .decision {
      border: 1px solid var(--proterra-line);
      padding: 3px 6px;
      font-size: 10px;
      height: fit-content;
      text-align: center;
    }
    .kept {
      color: var(--proterra-forest);
      border-color: var(--proterra-forest);
    }
    :is(.evidence-layout, .review-layout, .previews) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    :is(.claims, .review-copy, .previews > article) {
      min-width: 0;
    }
    .claim {
      padding: 12px 0;
      border-top: 1px solid var(--proterra-line);
    }
    .claim button {
      display: block;
      width: 100%;
      text-align: left;
      margin-top: 6px;
      background: transparent;
      border-color: transparent;
    }
    .claim button[aria-pressed="true"] {
      border-color: var(--proterra-forest);
      background: var(--proterra-surface);
    }
    .claim a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 10px;
      color: var(--proterra-forest);
      font-size: 12px;
    }
    :is(.evidence, .review-gate) {
      padding: 18px;
      border: 1px solid var(--proterra-line);
      border-radius: 2px;
      background: var(--proterra-surface);
      align-self: start;
      min-width: 0;
    }
    blockquote {
      margin: 12px 0;
      font-size: 13px;
      line-height: 1.7;
    }
    mark {
      background: var(--proterra-mint);
      color: var(--proterra-ink);
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
    }
    code {
      color: var(--proterra-muted);
      font-size: 10px;
      overflow-wrap: anywhere;
    }
    .fingerprint {
      display: grid;
      gap: 4px;
      padding: 8px 12px;
      border: 1px solid var(--proterra-line);
      font-size: 11px;
      color: var(--proterra-muted);
    }
    .fingerprint code {
      color: var(--proterra-forest);
      font-size: 12px;
    }
    label {
      display: grid;
      gap: 6px;
      font-size: 12px;
      color: var(--proterra-muted);
    }
    input,
    textarea {
      width: 100%;
      min-width: 0;
      min-height: 44px;
      padding: 10px;
      background: var(--proterra-surface);
      color: var(--proterra-ink);
      border: 1px solid var(--proterra-line);
      border-radius: 2px;
      font: inherit;
      font-size: 16px;
    }
    textarea {
      resize: none;
    }
    .review-copy ol {
      padding-left: 20px;
    }
    .review-copy li {
      padding: 8px 0;
      font-size: 12px;
    }
    .review-copy li strong {
      color: var(--proterra-forest);
    }
    .text-button {
      border: 0;
      padding: 4px 0;
      font-size: 12px;
      background: transparent;
    }
    .review-gate > button {
      display: block;
      width: 100%;
      margin-top: 12px;
    }
    [data-validation],
    .approval p {
      color: var(--proterra-muted);
      font-size: 12px;
    }
    .approval {
      margin: 18px 0;
      padding: 16px 0;
      border-block: 1px solid var(--proterra-line);
    }
    .approval strong {
      font-weight: 550;
    }
    .approval[data-approved="true"] strong {
      color: var(--proterra-forest);
    }
    .publish-gate {
      color: var(--proterra-muted);
      font-size: 12px;
      margin-bottom: 18px;
    }
    .previews > article {
      padding: 18px;
      border: 1px solid var(--proterra-line);
      border-radius: 2px;
      background: var(--proterra-surface);
    }
    .preview-brand {
      font-size: 20px;
      font-weight: 600;
      color: var(--proterra-forest);
      letter-spacing: -0.03em;
    }
    .website-preview h3 {
      margin-top: 16px;
    }
    .website-preview ul {
      list-style: none;
      margin: 14px 0;
      padding: 0;
    }
    .website-preview li {
      padding: 12px 0;
      border-top: 1px solid var(--proterra-line);
      font-size: 12px;
    }
    .website-preview li strong {
      color: var(--proterra-forest);
      font-size: 11px;
    }
    dl {
      margin: 12px 0;
      font-size: 11px;
    }
    dl > div {
      display: grid;
      grid-template-columns: 50px minmax(0, 1fr);
      gap: 8px;
      margin: 6px 0;
    }
    dt {
      color: var(--proterra-muted);
    }
    dd {
      margin: 0;
      overflow-wrap: anywhere;
    }
    .email-body {
      padding-top: 14px;
      border-top: 1px solid var(--proterra-line);
    }
    .email-story {
      padding: 10px 0;
      border-bottom: 1px solid var(--proterra-line);
      font-size: 12px;
    }
    .email-cta {
      display: block;
      padding: 12px;
      margin: 16px 0 8px;
      background: var(--proterra-forest);
      color: var(--proterra-surface);
      font-size: 12px;
    }
