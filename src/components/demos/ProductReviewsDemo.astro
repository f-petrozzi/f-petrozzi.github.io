---
import { PRODUCTS, SCHEMA } from "../../data/demos/product-reviews-analysis";
---

<section
  class="demo demo-product-reviews-analysis"
  data-demo="product-reviews-analysis"
  aria-label="Product Reviews Database interactive sample"
>
  <div class="pr-schema" role="group" aria-label="Schema">
    {
      SCHEMA.map((t, i) => (
        <>
          {i === 1 && <span class="pr-link">product_id</span>}
          <div class="pr-table-card">
            <strong>{t.table}</strong>
            <span>{t.columns.join(" / ")}</span>
          </div>
        </>
      ))
    }
  </div>

  <div class="pr-top">
    <div class="pr-tabs" role="group" aria-label="Views">
      <button type="button" data-view="reviews" aria-pressed="true"
        >Reviews</button
      >
      <button type="button" data-view="prep" aria-pressed="false"
        >Import prep</button
      >
    </div>
    <button type="button" class="pr-reset">Reset</button>
  </div>

  <div data-panel="reviews" class="pr-panel">
    <div class="pr-filters">
      <div class="pr-products" role="group" aria-label="Product">
        <button type="button" data-product="0" aria-pressed="true"
          >All products <span data-stat-all></span></button
        >
        {
          PRODUCTS.map((p) => (
            <button
              type="button"
              data-product={p.product_id}
              aria-pressed="false"
            >
              {p.product_name} <span data-stat />
            </button>
          ))
        }
      </div>
      <label class="pr-minlabel"
        ><span>Min rating</span>
        <select class="pr-min">
          <option value="0">Any</option>
          <option value="2">2+</option>
          <option value="3">3+</option>
          <option value="4">4+</option>
          <option value="5">5</option>
        </select></label
      >
    </div>

    <div class="pr-grid">
      <div class="pr-main" aria-live="polite">
        <div class="pr-sql-head"><span class="pr-kind">SELECT</span></div>
        <pre class="pr-sql" tabindex="0"><code /></pre>
        <div
          class="pr-table"
          tabindex="0"
          role="region"
          aria-label="Reviews joined to products"
        >
        </div>
      </div>

      <form class="pr-form" novalidate>
        <h2 class="pr-form-title" tabindex="-1">Add review</h2>
        <label
          ><span>Product</span>
          <select name="product">
            {
              PRODUCTS.map((p) => (
                <option value={p.product_id}>{p.product_name}</option>
              ))
            }
          </select></label
        >
        <label
          ><span>Reviewer</span><input
            type="text"
            name="reviewer"
            maxlength="60"
            autocomplete="off"
          /></label
        >
        <label
          ><span>Rating</span>
          <select name="rating">
            <option value="5">5</option>
            <option value="4">4</option>
            <option value="3">3</option>
            <option value="2">2</option>
            <option value="1">1</option>
          </select></label
        >
        <label
          ><span>Review</span><textarea name="text" rows="3" maxlength="500"
          ></textarea></label
        >
        <label><span>Date</span><input type="date" name="date" /></label>
        <div class="pr-actions">
          <button type="submit" class="pr-save pr-primary">Add review</button>
          <button type="button" class="pr-cancel" hidden>Cancel</button>
        </div>
        <p class="pr-error" role="alert"></p>
      </form>
    </div>
  </div>

  <div data-panel="prep" class="pr-panel" hidden>
    <div class="pr-tabs" role="group" aria-label="Show rows as">
      <button type="button" data-mode="raw" aria-pressed="false">Raw</button>
      <button type="button" data-mode="clean" aria-pressed="true"
        >Cleaned</button
      >
    </div>
    <div
      class="pr-prep-table pr-table"
      tabindex="0"
      role="region"
      aria-label="Rows prepared for import"
    >
    </div>
    <pre class="pr-prep-sql pr-sql" tabindex="0"><code /></pre>
    <button type="button" class="pr-import pr-primary">Import rows</button>
  </div>

  <p class="pr-note">Statements use local sample tables.</p>
</section>

<script>
  import "../../scripts/demos/product-reviews-analysis";
</script>
<style is:inline>
  .demo-product-reviews-analysis {
    --demo-bg: #0a0f18;
    --demo-ink: #eef3f8;
    --demo-muted: #a9b6c7;
    --demo-faint: #9aa9bd;
    --demo-accent: #8fd8f2;
    --demo-accent-ink: #06121c;
    --demo-line: rgb(255 255 255 / 0.12);
    --demo-glass-tint: #101826;
    color-scheme: dark;
    background: var(--demo-bg);

    & {
      --pr-surface: color-mix(in srgb, var(--demo-ink) 5%, transparent);
      --pr-surface-2: color-mix(in srgb, var(--demo-ink) 9%, transparent);
      --pr-hit: color-mix(in srgb, var(--demo-accent) 20%, transparent);
      --pr-bad: #e5484d;
      margin: 28px 0;
      padding: 18px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-lg);
      background: var(--demo-bg);
      color: var(--demo-ink);
      font-size: 14px;
      line-height: 1.5;
      min-width: 0;
    }
    [hidden] {
      display: none !important;
    }
    button,
    select,
    input,
    textarea {
      font: inherit;
      touch-action: manipulation;
    }
    .pr-schema {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      gap: 8px;
    }
    .pr-table-card {
      display: grid;
      gap: 2px;
      flex: 1 1 240px;
      min-width: 0;
      padding: 10px 14px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      background: var(--pr-surface);
    }
    .pr-table-card strong {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--demo-accent);
    }
    .pr-table-card span {
      color: var(--demo-muted);
      font-size: 12px;
    }
    .pr-link {
      align-self: center;
      padding: 2px 10px;
      border: 1px dashed var(--demo-accent);
      border-radius: 999px;
      color: var(--demo-accent);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
    }
    .pr-top {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: space-between;
      margin-top: 14px;
    }
    .pr-tabs,
    .pr-products {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    button {
      min-height: 44px;
      padding: 8px 14px;
      border: 1px solid var(--demo-line);
      border-radius: 999px;
      background: transparent;
      color: var(--demo-muted);
      cursor: pointer;
    }
    button:hover:not(:disabled) {
      color: var(--demo-ink);
      border-color: var(--demo-accent);
    }
    button[aria-pressed="true"],
    .pr-primary {
      background: var(--demo-accent);
      border-color: var(--demo-accent);
      color: var(--demo-accent-ink);
    }
    button:disabled {
      opacity: 0.55;
      cursor: default;
    }
    .pr-reset {
      color: var(--demo-accent);
    }
    .pr-panel {
      margin-top: 14px;
      min-width: 0;
    }
    .pr-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 16px;
      align-items: center;
      justify-content: space-between;
    }
    .pr-products button span {
      margin-left: 4px;
      font-size: 12px;
      opacity: 0.8;
      font-variant-numeric: tabular-nums;
    }
    .pr-minlabel {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--demo-muted);
    }
    select,
    input,
    textarea {
      min-height: 44px;
      padding: 6px 12px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      background: var(--pr-surface-2);
      color: var(--demo-ink);
      max-width: 100%;
    }
    select option {
      background: var(--demo-bg);
      color: var(--demo-ink);
    }
    .pr-grid {
      display: grid;
      gap: 18px;
      margin-top: 14px;
      grid-template-columns: minmax(0, 1fr);
    }
    @media (min-width: 1000px) {
      .pr-grid {
        grid-template-columns: minmax(0, 1fr) 300px;
        align-items: start;
      }
    }
    .pr-main {
      min-width: 0;
    }
    .pr-sql-head {
      margin-bottom: 6px;
    }
    .pr-kind {
      display: inline-block;
      padding: 1px 10px;
      border-radius: 999px;
      background: var(--demo-accent);
      color: var(--demo-accent-ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      font-weight: 600;
    }
    .pr-sql {
      margin: 0 0 12px;
      padding: 12px 14px;
      overflow-x: auto;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      background: var(--pr-surface-2);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12.5px;
      line-height: 1.6;
      max-height: 440px;
      overscroll-behavior: contain;
    }
    .pr-table {
      overflow-x: auto;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      max-height: 440px;
      overscroll-behavior: contain;
    }
    .pr-table table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .pr-table th,
    .pr-table td {
      padding: 9px 12px;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--demo-line);
    }
    .pr-table tbody tr:last-child td {
      border-bottom: 0;
    }
    .pr-table th {
      color: var(--demo-muted);
      font-weight: 500;
      background: var(--pr-surface);
      white-space: nowrap;
    }
    .pr-table td:not(.is-text) {
      white-space: nowrap;
    }
    .pr-table .is-text {
      min-width: 220px;
      white-space: pre-wrap;
    }
    .pr-table .is-num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .pr-table .is-raw {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      white-space: pre-wrap;
    }
    .pr-table .is-changed {
      background: var(--pr-hit);
    }
    .pr-table tr.is-hit {
      background: var(--pr-hit);
    }
    .pr-table tr.is-editing {
      outline: 1px solid var(--demo-accent);
      outline-offset: -1px;
    }
    .pr-table tr.is-skipped td:not(.is-result) {
      opacity: 0.55;
      text-decoration: line-through;
    }
    .pr-table .is-empty {
      padding: 22px;
      color: var(--demo-muted);
      text-align: center;
    }
    .pr-table .is-actions {
      padding: 4px 8px;
      text-align: right;
      white-space: nowrap;
    }
    .pr-table .pr-row-btn {
      min-height: 44px;
      min-width: 44px;
      margin-left: 4px;
      padding: 6px 12px;
      border: 1px solid var(--demo-line);
      border-radius: 999px;
      background: transparent;
      color: var(--demo-muted);
      font: inherit;
      cursor: pointer;
    }
    .pr-table .pr-row-btn:hover {
      color: var(--demo-ink);
      border-color: var(--demo-accent);
    }
    .pr-table .pr-row-btn.is-danger:hover {
      color: var(--pr-bad);
      border-color: var(--pr-bad);
    }
    .pr-table .pr-chip {
      display: inline-block;
      margin: 0 4px 4px 0;
      padding: 0 8px;
      border: 1px solid var(--demo-line);
      border-radius: 999px;
      color: var(--demo-muted);
      font-size: 12px;
    }
    .pr-table .pr-chip.is-bad {
      border-color: var(--pr-bad);
      color: var(--pr-bad);
    }
    .pr-table .pr-sr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .pr-form {
      display: grid;
      gap: 10px;
      padding: 14px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-md);
      background: var(--pr-surface);
      min-width: 0;
    }
    .pr-form-title {
      margin: 0;
      font-size: 16px;
      font-weight: 600;
    }
    .pr-form label {
      display: grid;
      gap: 4px;
      color: var(--demo-muted);
      font-size: 12px;
      min-width: 0;
    }
    .pr-form select,
    .pr-form input,
    .pr-form textarea {
      width: 100%;
      font-size: 16px;
    }
    .pr-form textarea {
      resize: vertical;
    }
    .pr-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .pr-error {
      margin: 0;
      color: var(--pr-bad);
      font-size: 13px;
    }
    .pr-prep-table {
      margin-top: 12px;
    }
    .pr-prep-sql {
      margin-top: 12px;
    }
    .pr-import {
      margin-top: 4px;
    }
    .pr-note {
      margin: 16px 0 0;
      color: var(--demo-faint);
      font-size: 12px;
    }
    @media (prefers-reduced-motion: reduce) {
      button {
        transition: none;
      }
    }

    &,
    * {
      scrollbar-width: thin;
      scrollbar-color: #52647a transparent;
    }
    &::-webkit-scrollbar,
    *::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    &::-webkit-scrollbar-thumb,
    *::-webkit-scrollbar-thumb {
      background: #52647a;
      border-radius: 8px;
    }
    &::-webkit-scrollbar-track,
    *::-webkit-scrollbar-track {
      background: transparent;
    }
    .pr-panel {
      max-height: 580px;
      overflow: auto;
      overscroll-behavior: contain;
    }
    textarea {
      max-height: 180px;
    }
  }
</style>
