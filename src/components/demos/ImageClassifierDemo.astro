---
import {
  conditions,
  models,
  examples,
} from "../../data/demos/image-classifier";
---

<section
  class="demo demo-image-classifier"
  data-demo="image-classifier"
  aria-label="Image Classifier interactive sample"
>
  <h2>Chest X-ray / multi-label comparison</h2>
  <div class="columns" aria-live="polite">
    {
      models.map((model, i) => (
        <article class="card" data-model={i}>
          <>
            <h3>{model}</h3>
            <div data-probabilities />
            <div class="scroll" data-matrix />
            <p data-metrics />
          </>
        </article>
      ))
    }
  </div>
  <div class="thumbnails" role="group" aria-label="Illustrative chest diagrams">
    {
      examples.map((example, i) => (
        <button
          type="button"
          data-image={i}
          aria-pressed={i === 0 ? "true" : "false"}
          aria-label={`Select ${example.title}`}
        >
          <>
            <svg viewBox="0 0 100 110" aria-hidden="true">
              <>
                <rect
                  x="2"
                  y="2"
                  width="96"
                  height="106"
                  rx="12"
                  fill="var(--demo-bg)"
                  stroke="var(--demo-muted)"
                />
                <path
                  d="M47 20C27 10 14 36 19 74Q26 98 44 83ZM53 20C73 10 86 36 81 74Q74 98 56 83Z"
                  fill="var(--demo-muted)"
                  opacity=".35"
                />
                <path
                  d="M50 12V90M23 35Q50 44 77 35M19 48Q50 58 81 48M19 63Q50 74 81 63"
                  fill="none"
                  stroke="var(--demo-muted)"
                />
                <ellipse
                  cx="32"
                  cy="76"
                  rx="13"
                  ry="9"
                  fill="var(--demo-ink)"
                  opacity={example.opacity[0]}
                />
                <path
                  d="M62 74L78 65L78 86L62 88Z"
                  fill="var(--demo-ink)"
                  opacity={example.opacity[1]}
                />
                <ellipse
                  cx="66"
                  cy="45"
                  rx="12"
                  ry="18"
                  fill="var(--demo-ink)"
                  opacity={example.opacity[2]}
                />
              </>
            </svg>
            <span>{example.title}</span>
          </>
        </button>
      ))
    }
  </div>
  <p data-selected aria-live="polite">Clear fields</p>
  <div class="toolbar">
    <label
      >Evaluation condition<select
        >{conditions.map((c, i) => <option value={i}>{c}</option>)}</select
      ></label
    ><button type="button" data-reset>Reset</button>
  </div>
  <p class="note">
    Illustrative diagrams, fixed model scores, and invented evaluation counts;
    no neural network runs here. Probabilities are independent, not a diagnosis.
  </p>
</section>
<script>
  import "../../scripts/demos/image-classifier";
</script>
<style is:inline>
  .demo-image-classifier {
    --demo-bg: #0a0f18;
    --demo-ink: #eef3f8;
    --demo-muted: #a9b6c7;
    --demo-faint: #9aa9bd;
    --demo-accent: #8fd8f2;
    --demo-accent-ink: #06121c;
    --demo-line: rgb(255 255 255 / 0.12);
    --demo-glass-tint: #101826;
    color-scheme: dark;
    background: var(--demo-bg);

    & {
      margin: 28px 0;
      padding: clamp(14px, 3vw, 28px);
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-lg);
      background: var(--demo-bg);
      color: var(--demo-ink);
      font-size: 14px;
      line-height: 1.55;
      min-width: 0;
    }
    & .columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    & .card {
      min-width: 0;
      padding: 18px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-md);
    }
    & h2 {
      margin: 0 0 14px;
      font-size: 22px;
      letter-spacing: -0.025em;
    }
    & h3 {
      margin: 0 0 10px;
      font-size: 16px;
    }
    & p {
      margin: 12px 0;
    }
    & .muted,
    & .note {
      color: var(--demo-muted);
    }
    & .note {
      font-size: 12px;
      margin-bottom: 0;
    }
    & .score {
      display: block;
      color: var(--demo-accent);
      font-size: clamp(28px, 5vw, 42px);
      line-height: 1.2;
      margin: 10px 0;
    }
    & .toolbar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
      margin: 18px 0;
    }
    & button,
    & select {
      font: inherit;
      min-height: 44px;
      padding: 8px 12px;
      background: var(--demo-bg);
      color: var(--demo-ink);
      border: 1px solid var(--demo-muted);
      border-radius: 8px;
      max-width: 100%;
    }
    & button {
      cursor: pointer;
      touch-action: manipulation;
    }
    & button[aria-pressed="true"] {
      border-color: var(--demo-accent);
      box-shadow: inset 0 0 0 1px var(--demo-accent);
      color: var(--demo-accent);
    }
    & button:disabled {
      opacity: 0.5;
      cursor: default;
    }
    & label {
      display: grid;
      gap: 6px;
      min-width: 0;
    }
    & .inputs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin: 18px 0;
    }
    & input,
    & select {
      font-size: 16px;
      accent-color: var(--demo-accent);
    }
    & input[type="range"] {
      width: 100%;
      min-height: 44px;
      margin: 0;
    }
    & input[type="checkbox"] {
      width: 22px;
      height: 22px;
      margin: 10px;
    }
    & .check {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    & .scroll {
      overflow-x: auto;
      max-width: 100%;
      max-height: 440px;
      overscroll-behavior: contain;
    }
    & table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    & th,
    & td {
      padding: 9px 6px;
      border-bottom: 1px solid var(--demo-line);
      text-align: left;
    }
    & th {
      font-weight: 500;
    }
    & svg {
      display: block;
      width: 100%;
      height: auto;
    }
    & svg text {
      fill: var(--demo-muted);
      font:
        12px system-ui,
        sans-serif;
    }
    & .axis {
      fill: none;
      stroke: var(--demo-muted);
      stroke-width: 1;
    }
    & .series {
      fill: none;
      stroke: var(--demo-accent);
      stroke-width: 2.5;
    }
    & .point {
      fill: var(--demo-accent);
    }
    & .secondary {
      fill: var(--demo-muted);
    }
    & .selected {
      stroke: var(--demo-accent);
      stroke-width: 2.5;
      fill: none;
    }
    & .branch {
      stroke: var(--demo-muted);
      stroke-width: 1;
      fill: none;
    }
    & g rect {
      fill: var(--demo-bg);
    }
    & g text {
      stroke: none;
      text-anchor: middle;
      font-size: 10px;
    }
    @media (max-width: 680px) {
      & .columns {
        grid-template-columns: 1fr;
      }
      & .inputs {
        grid-template-columns: 1fr 1fr;
      }
      & .card {
        padding: 12px;
      }
    }
    @media (max-width: 380px) {
      & .inputs {
        grid-template-columns: 1fr;
      }
    }

    & .thumbnails {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 8px;
      margin-top: 18px;
    }
    & .thumbnails button {
      padding: 8px;
      font-size: 12px;
    }
    & .thumbnails svg {
      max-height: 110px;
    }
    & .thumbnails span {
      display: block;
      margin-top: 6px;
    }
    @media (max-width: 680px) {
      & .thumbnails {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    &,
    * {
      scrollbar-width: thin;
      scrollbar-color: #52647a transparent;
    }
    &::-webkit-scrollbar,
    *::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    &::-webkit-scrollbar-thumb,
    *::-webkit-scrollbar-thumb {
      background: #52647a;
      border-radius: 8px;
    }
    &::-webkit-scrollbar-track,
    *::-webkit-scrollbar-track {
      background: transparent;
    }

    .toolbar {
      flex-wrap: nowrap;
      align-items: center;
    }
    .toolbar label {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 12px;
      flex: 1;
    }
    .toolbar select,
    .toolbar button {
      height: 44px;
    }
    .toolbar select {
      flex: 1;
      min-width: 0;
    }
    .toolbar button {
      flex: none;
    }
    @media (max-width: 480px) {
      .toolbar label {
        font-size: 12px;
      }
    }
  }
</style>
