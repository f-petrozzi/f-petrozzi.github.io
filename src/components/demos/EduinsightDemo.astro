---
import { PROGRAMS, TERMS } from "../../data/demos/eduinsight";
---

<section
  class="demo demo-eduinsight"
  data-demo="eduinsight"
  aria-label="EduInsight interactive sample"
>
  <header class="ei-nav">
    <span class="ei-brand">EduInsight</span>
    <span class="ei-crumb">Enrollments</span>
    <button type="button" class="ei-reset" data-reset>Reset</button>
  </header>

  <div class="ei-filters">
    <div class="ei-filter">
      <label for="ei-f-program">Program</label>
      <select id="ei-f-program" data-filter-program>
        <option value="">All programs</option>
        {PROGRAMS.map((p) => <option value={p.name}>{p.name}</option>)}
      </select>
    </div>
    <div class="ei-filter">
      <label for="ei-f-term">Term</label>
      <select id="ei-f-term" data-filter-term>
        <option value="">All terms</option>
        {TERMS.map((t) => <option value={t}>{t}</option>)}
      </select>
    </div>
    <button type="button" class="ei-btn" data-create>Create New</button>
    <p class="ei-status" data-status role="status" aria-live="polite"></p>
  </div>

  <div class="ei-grid">
    <section class="ei-panel" data-main aria-label="Enrollment records">
    </section>
    <div class="ei-side">
      <section class="ei-card" aria-labelledby="ei-h-programs">
        <h3 id="ei-h-programs">Enrollments by program</h3>
        <div data-chart-programs></div>
      </section>
      <section class="ei-card" aria-labelledby="ei-h-gpa">
        <h3 id="ei-h-gpa">GPA distribution</h3>
        <div data-chart-gpa></div>
      </section>
      <section class="ei-card" aria-labelledby="ei-h-bench">
        <h3 id="ei-h-bench">
          Benchmark <span class="ei-tag">Illustrative</span>
        </h3>
        <div data-bench aria-live="polite"></div>
        <p class="ei-foot">
          Peer averages are invented, in the style of College Scorecard data.
        </p>
      </section>
    </div>
  </div>
</section>

<script>
  import "../../scripts/demos/eduinsight";
</script>
<style is:inline>
  .demo-eduinsight {
    --demo-bg: #0a0f18;
    --demo-ink: #eef3f8;
    --demo-muted: #a9b6c7;
    --demo-faint: #9aa9bd;
    --demo-accent: #8fd8f2;
    --demo-accent-ink: #06121c;
    --demo-line: rgb(255 255 255 / 0.12);
    --demo-glass-tint: #101826;
    color-scheme: dark;
    background: var(--demo-bg);

    & {
      --ei-bad: #ff9a9a;
      --ei-stripe: rgb(255 255 255 / 0.035);
      display: grid;
      gap: 16px;
      min-width: 0;
      padding: 16px;
      border: 1px solid var(--demo-line);
      border-radius: 20px;
      background: var(--demo-bg);
      color: var(--demo-ink);
      font-size: 14px;
      line-height: 1.5;
    }
    & button,
    & select,
    & input {
      font: inherit;
      touch-action: manipulation;
    }
    .ei-nav {
      display: flex;
      align-items: center;
      gap: 16px;
      min-height: 52px;
      padding: 0 8px 0 16px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      background: rgb(128 140 160 / 0.12);
    }
    .ei-brand {
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .ei-crumb {
      flex: 1;
      color: var(--demo-muted);
    }
    .ei-reset,
    .ei-btn {
      min-height: 44px;
      padding: 0 18px;
      border-radius: 6px;
      cursor: pointer;
    }
    .ei-reset {
      border: 1px solid var(--demo-line);
      background: none;
      color: var(--demo-ink);
    }
    .ei-btn {
      border: 1px solid var(--demo-accent);
      background: var(--demo-accent);
      color: var(--demo-accent-ink);
      font-weight: 500;
    }
    .ei-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }
    .ei-filters {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 10px 14px;
    }
    .ei-filter {
      display: grid;
      gap: 3px;
      min-width: 0;
    }
    .ei-filter label,
    & .ei-row label {
      color: var(--demo-muted);
      font-size: 12px;
    }
    & select,
    & .ei-row input,
    & .ei-row select {
      min-height: 44px;
      padding: 0 10px;
      border: 1px solid var(--demo-line);
      border-radius: 6px;
      background: var(--demo-bg);
      color: var(--demo-ink);
      font-size: 16px;
      max-width: 100%;
    }
    .ei-status {
      flex: 1;
      min-width: 120px;
      margin: 0;
      color: var(--demo-muted);
      font-size: 13px;
    }
    .ei-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 16px;
      align-items: start;
    }
    .ei-panel,
    .ei-card {
      min-width: 0;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      padding: 14px;
    }
    .ei-side {
      display: grid;
      gap: 16px;
      min-width: 0;
    }
    .ei-card h3 {
      margin: 0 0 8px;
      font-size: 15px;
      font-weight: 500;
    }
    .ei-tag {
      margin-left: 6px;
      padding: 1px 8px;
      border: 1px solid var(--demo-line);
      border-radius: 999px;
      color: var(--demo-muted);
      font-size: 11px;
      font-weight: 400;
    }
    .ei-foot {
      margin: 8px 0 0;
      color: var(--demo-faint);
      font-size: 12px;
    }
    & .ei-panel-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--demo-line);
    }
    & .ei-panel-head h2 {
      margin: 0;
      font-size: 20px;
      font-weight: 500;
      letter-spacing: -0.02em;
    }
    & .ei-panel-head span {
      color: var(--demo-muted);
      font-size: 13px;
    }
    & .ei-scroll {
      overflow: auto;
      border-radius: 6px;
      max-height: 440px;
      overscroll-behavior: contain;
    }
    & .ei-table {
      width: 100%;
      min-width: 580px;
      border-collapse: collapse;
    }
    & .ei-table th {
      position: sticky;
      top: 0;
      padding: 8px 10px;
      text-align: left;
      border-bottom: 2px solid var(--demo-line);
      background: var(--demo-bg);
      color: var(--demo-muted);
      font-size: 12px;
      font-weight: 500;
    }
    & .ei-table td {
      padding: 2px 10px;
      border-bottom: 1px solid var(--demo-line);
      white-space: nowrap;
    }
    & .ei-table tbody tr:nth-child(odd) {
      background: var(--ei-stripe);
    }
    & .num {
      text-align: right !important;
      font-variant-numeric: tabular-nums;
    }
    & .ei-none {
      color: var(--demo-muted);
      padding: 12px 10px;
    }
    & .ei-link {
      min-height: 44px;
      padding: 0 8px;
      border: 0;
      background: none;
      color: var(--demo-accent);
      text-decoration: underline;
      cursor: pointer;
    }
    & .ei-sr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    & .ei-form {
      display: grid;
      gap: 12px;
      max-width: 420px;
    }
    & .ei-row {
      display: grid;
      gap: 3px;
    }
    & .ei-row [aria-invalid="true"] {
      border-color: var(--ei-bad);
    }
    & .ei-field-err {
      color: var(--ei-bad);
      font-size: 12px;
    }
    & .ei-field-err:empty {
      display: none;
    }
    & .ei-summary {
      padding: 10px 14px;
      border: 1px solid var(--ei-bad);
      border-radius: 6px;
      color: var(--ei-bad);
    }
    & .ei-summary ul {
      margin: 4px 0 0;
      padding-left: 18px;
    }
    & .ei-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    & .ei-actions .ei-btn {
      min-height: 44px;
      padding: 0 18px;
      border: 1px solid var(--demo-accent);
      border-radius: 6px;
      background: var(--demo-accent);
      color: var(--demo-accent-ink);
      cursor: pointer;
    }
    /* charts */
    & svg {
      display: block;
      width: 100%;
      height: auto;
      max-height: 180px;
    }
    & .ei-bar {
      fill: var(--demo-accent);
    }
    & .ei-t {
      fill: var(--demo-muted);
      font-size: 12px;
    }
    & .ei-v {
      fill: var(--demo-ink);
      font-size: 12px;
      font-variant-numeric: tabular-nums;
    }
    & .ei-axis {
      stroke: var(--demo-line);
      stroke-width: 1;
    }
    & .ei-me {
      fill: var(--demo-accent);
      stroke: var(--demo-bg);
      stroke-width: 2;
    }
    & .ei-peer {
      fill: var(--demo-bg);
      stroke: var(--demo-ink);
      stroke-width: 2;
    }
    & .ei-scope {
      margin: 0 0 8px;
      color: var(--demo-muted);
      font-size: 13px;
    }
    & .ei-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin: 0 0 10px;
    }
    & .ei-stats dt {
      color: var(--demo-muted);
      font-size: 12px;
    }
    & .ei-stats dd {
      margin: 0;
      font-size: 22px;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }
    & .ei-key {
      display: flex;
      gap: 14px;
      margin: 4px 0 0;
      color: var(--demo-muted);
      font-size: 12px;
    }
    & .ei-key i {
      display: inline-block;
      width: 10px;
      height: 10px;
      margin-right: 5px;
      border-radius: 50%;
    }
    & .ei-key .me {
      background: var(--demo-accent);
    }
    & .ei-key .peer {
      border: 2px solid var(--demo-ink);
    }
    @media (max-width: 900px) {
      .ei-grid {
        grid-template-columns: minmax(0, 1fr);
      }
      .ei-side {
        order: -1;
      }
    }
    @media (max-width: 520px) {
      & {
        padding: 10px;
      }
      .ei-filter,
      .ei-filter select {
        width: 100%;
      }
      .ei-filters .ei-btn {
        width: 100%;
      }
      & .ei-stats dd {
        font-size: 18px;
      }
    }

    &,
    * {
      scrollbar-width: thin;
      scrollbar-color: #52647a transparent;
    }
    &::-webkit-scrollbar,
    *::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    &::-webkit-scrollbar-thumb,
    *::-webkit-scrollbar-thumb {
      background: #52647a;
      border-radius: 8px;
    }
    &::-webkit-scrollbar-track,
    *::-webkit-scrollbar-track {
      background: transparent;
    }
    .ei-scroll {
      height: 360px;
      max-height: 360px;
    }
    [data-main] {
      max-height: 560px;
      overflow: auto;
      overscroll-behavior: contain;
    }
  }
</style>
