---
import { SERVICES } from "../../data/demos/tixly-app-design";
---

<section
  class="demo demo-tixly-app-design"
  data-demo="tixly-app-design"
  data-fidelity="high"
  aria-label="Tixly App Design interactive sample"
>
  <div class="tx-bar">
    <div class="tx-fid" role="group" aria-label="Fidelity">
      <button type="button" data-fidelity="low" aria-pressed="false"
        >Low fidelity</button
      >
      <button type="button" data-fidelity="high" aria-pressed="true"
        >High fidelity</button
      >
    </div>
    <button type="button" class="tx-reset" data-reset>Reset</button>
  </div>

  <div class="tx-main">
    <div class="tx-phone">
      <div class="tx-notch" aria-hidden="true"></div>
      <div class="tx-screen" data-screen></div>
      <nav class="tx-tabs" aria-label="Tixly app">
        <button type="button" data-tab="events" aria-current="page"
          >Events</button
        >
        <button type="button" data-tab="wallet">Tickets</button>
      </nav>
    </div>

    <section class="tx-door" aria-labelledby="tx-door-title">
      <h2 id="tx-door-title">Validate at the door</h2>
      <form data-door-form novalidate>
        <label for="tx-door-input">Ticket ID</label>
        <div class="tx-door-row">
          <input
            id="tx-door-input"
            data-door-input
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            placeholder="TX-XXXX-XXXX"
          />
          <button type="submit">Scan</button>
        </div>
      </form>
      <div
        class="tx-result"
        data-door-result
        data-state="idle"
        role="status"
        aria-live="polite"
      >
      </div>
      <details class="tx-sold">
        <summary>Sold list (<span data-sold-count>0</span>)</summary>
        <div class="tx-chips" data-sold></div>
      </details>
    </section>
  </div>

  <ol class="tx-arch" aria-label="Services touched by each step">
    {
      SERVICES.map((svc) => (
        <li data-svc={svc.id}>
          <b>{svc.name}</b>
          <span>{svc.note}</span>
        </li>
      ))
    }
  </ol>
  <p class="tx-note" data-arch-note aria-live="polite"></p>
  <p class="tx-sim">
    This sample runs no payments, seat holds or validation service. QR codes are
    illustrative.
  </p>
</section>

<script>
  import "../../scripts/demos/tixly-app-design";
</script>
<style is:inline>
  .demo-tixly-app-design {
    --demo-bg: #0a0f18;
    --demo-ink: #eef3f8;
    --demo-muted: #a9b6c7;
    --demo-faint: #9aa9bd;
    --demo-accent: #8fd8f2;
    --demo-accent-ink: #06121c;
    --demo-line: rgb(255 255 255 / 0.12);
    --demo-glass-tint: #101826;
    color-scheme: dark;
    background: var(--demo-bg);

    & {
      --tx-ok: #7ddba0;
      --tx-warn: #f2c46d;
      --tx-bad: #ff9a9a;
      display: grid;
      gap: 20px;
      padding: 20px;
      border: 1px solid var(--demo-line);
      border-radius: 20px;
      background: var(--demo-bg);
      color: var(--demo-ink);
      font-size: 14px;
      line-height: 1.5;
      min-width: 0;
    }
    & button {
      font: inherit;
      touch-action: manipulation;
    }
    .tx-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 10px;
    }
    .tx-fid {
      display: inline-flex;
      padding: 3px;
      border: 1px solid var(--demo-line);
      border-radius: 999px;
    }
    .tx-fid button,
    .tx-reset,
    .tx-door button {
      min-height: 44px;
      padding: 0 16px;
      border: 0;
      border-radius: 999px;
      background: none;
      color: var(--demo-muted);
      cursor: pointer;
    }
    .tx-fid button[aria-pressed="true"] {
      background: var(--demo-accent);
      color: var(--demo-accent-ink);
    }
    .tx-reset {
      border: 1px solid var(--demo-line);
      color: var(--demo-ink);
    }
    .tx-main {
      display: grid;
      grid-template-columns: minmax(0, 580px) minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }
    .tx-door {
      display: grid;
      gap: 12px;
      padding: 18px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-md);
      min-width: 0;
    }
    .tx-door h2 {
      margin: 0;
      font-size: 18px;
      font-weight: 500;
      letter-spacing: -0.02em;
    }
    .tx-door label {
      display: block;
      margin-bottom: 4px;
      color: var(--demo-muted);
      font-size: 12px;
    }
    .tx-door-row {
      display: flex;
      gap: 8px;
    }
    .tx-door input {
      flex: 1;
      min-width: 0;
      min-height: 44px;
      padding: 0 12px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--demo-ink);
      font: inherit;
      font-size: 16px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0.04em;
    }
    .tx-door-row button {
      background: var(--demo-accent);
      color: var(--demo-accent-ink);
    }
    .tx-result {
      display: grid;
      gap: 2px;
      padding: 12px 14px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      word-break: break-word;
    }
    .tx-result span {
      color: var(--demo-muted);
      font-size: 13px;
    }
    .tx-result[data-state="admit"] b {
      color: var(--tx-ok);
    }
    .tx-result[data-state="used"] b {
      color: var(--tx-warn);
    }
    .tx-result[data-state="unknown"] b,
    .tx-result[data-state="empty"] b {
      color: var(--tx-bad);
    }
    .tx-sold summary {
      display: flex;
      align-items: center;
      min-height: 44px;
      cursor: pointer;
      color: var(--demo-muted);
    }
    .tx-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      max-height: 190px;
      overflow: auto;
      overscroll-behavior: contain;
    }
    .tx-chips .tx-chip {
      min-height: 44px;
      padding: 0 10px;
      border: 1px solid var(--demo-line);
      border-radius: 8px;
      background: none;
      color: var(--demo-ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      cursor: pointer;
    }
    .tx-chips .tx-chip.is-used {
      color: var(--demo-faint);
      text-decoration: line-through;
    }

    .tx-arch {
      display: flex;
      gap: 0;
      margin: 0;
      padding: 2px 2px 8px;
      list-style: none;
    }
    .tx-arch li {
      position: relative;
      flex: 1 1 0;
      min-width: 0;
      overflow-wrap: anywhere;
      display: grid;
      gap: 0;
      margin-right: 18px;
      padding: 9px 11px;
      border: 1px solid var(--demo-line);
      border-radius: var(--radius-sm);
      color: var(--demo-faint);
    }
    .tx-arch li:last-child {
      margin-right: 0;
    }
    .tx-arch li:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 50%;
      right: -19px;
      width: 18px;
      border-top: 1px solid var(--demo-line);
    }
    .tx-arch b {
      font-weight: 500;
      font-size: 13px;
    }
    .tx-arch span {
      font-size: 12px;
    }
    .tx-arch li[data-active] {
      border-color: var(--demo-accent);
      color: var(--demo-ink);
      background: color-mix(in srgb, var(--demo-accent) 12%, transparent);
    }
    .tx-arch li[data-active] b {
      color: var(--demo-accent);
    }
    .tx-note {
      margin: -6px 0 0;
      color: var(--demo-muted);
      font-size: 13px;
    }
    .tx-sim {
      margin: 0;
      color: var(--demo-faint);
      font-size: 12px;
    }

    /* Phone (self-contained palette; fidelity swaps the variables) */
    .tx-phone {
      --p-bg: #ffffff;
      --p-ink: #1b1830;
      --p-muted: #5d5a73;
      --p-line: #dcd9ec;
      --p-card: #f4f3fb;
      --p-accent: #5a47d6;
      --p-accent-ink: #ffffff;
      --p-radius: 14px;
      --p-bs: solid;
      --p-seat-open: #e4e1f7;
      --p-seat-taken: #c9c6d8;
      position: relative;
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 580px;
      height: 640px;
      margin: 0 auto;
      overflow: hidden;
      border: 8px solid #14121f;
      border-radius: 34px;
      background: var(--p-bg);
      color: var(--p-ink);
      font-size: 14px;
    }
    &[data-fidelity="low"] .tx-phone {
      --p-bg: #f3f3f3;
      --p-ink: #303030;
      --p-muted: #606060;
      --p-line: #8a8a8a;
      --p-card: #e3e3e3;
      --p-accent: #4a4a4a;
      --p-accent-ink: #ffffff;
      --p-radius: 3px;
      --p-bs: dashed;
      --p-seat-open: #f3f3f3;
      --p-seat-taken: #c4c4c4;
      border-color: #6a6a6a;
      border-radius: 18px;
    }
    .tx-notch {
      flex: none;
      width: 90px;
      height: 6px;
      margin: 8px auto 4px;
      border-radius: 3px;
      background: var(--p-line);
    }
    .tx-screen {
      flex: 1;
      overflow-y: auto;
      padding: 6px 16px 18px;
      overscroll-behavior: contain;
      max-height: 440px;
      overscroll-behavior: contain;
    }
    .tx-tabs {
      flex: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-top: 1px var(--p-bs) var(--p-line);
    }
    .tx-tabs button {
      min-height: 52px;
      border: 0;
      background: var(--p-bg);
      color: var(--p-muted);
      cursor: pointer;
    }
    .tx-tabs button[aria-current] {
      color: var(--p-accent);
      font-weight: 600;
      box-shadow: inset 0 3px 0 var(--p-accent);
    }
    .tx-phone button {
      font: inherit;
      touch-action: manipulation;
      cursor: pointer;
    }
    .tx-phone .tx-h {
      margin: 8px 0 10px;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    .tx-phone .tx-h:focus {
      outline: none;
    }
    .tx-phone p {
      margin: 0 0 10px;
    }
    .tx-phone .tx-list,
    .tx-phone .tx-tiers,
    .tx-phone .tx-lines,
    .tx-phone .tx-minis {
      display: grid;
      gap: 8px;
      margin: 0 0 12px;
      padding: 0;
      list-style: none;
    }
    .tx-phone .tx-event {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr) auto;
      gap: 12px;
      align-items: center;
      width: 100%;
      min-height: 76px;
      padding: 6px;
      text-align: left;
      border: 1px var(--p-bs) var(--p-line);
      border-radius: var(--p-radius);
      background: var(--p-card);
      color: inherit;
    }
    .tx-phone .tx-event-body {
      display: grid;
      min-width: 0;
    }
    .tx-phone .tx-event-body b {
      font-weight: 600;
      line-height: 1.25;
    }
    .tx-phone small {
      color: var(--p-muted);
      font-size: 12px;
    }
    .tx-phone .tx-from {
      padding-right: 6px;
      color: var(--p-accent);
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }
    .tx-phone .tx-art {
      display: grid;
      place-items: center;
      width: 64px;
      height: 64px;
      border-radius: calc(var(--p-radius) - 4px);
      background: linear-gradient(
        135deg,
        hsl(var(--h) 70% 42%),
        hsl(calc(var(--h) + 40) 70% 30%)
      );
      color: #fff;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .tx-phone .tx-art.is-tall {
      width: 100%;
      height: 130px;
      margin-bottom: 8px;
      font-size: 12px;
    }
    &[data-fidelity="low"] .tx-phone .tx-art {
      background:
        linear-gradient(
          to top right,
          transparent calc(50% - 1px),
          #8a8a8a 50%,
          transparent calc(50% + 1px)
        ),
        linear-gradient(
          to bottom right,
          transparent calc(50% - 1px),
          #8a8a8a 50%,
          transparent calc(50% + 1px)
        ),
        #d6d6d6;
      border: 1px dashed #8a8a8a;
      color: transparent;
    }
    .tx-phone .tx-back {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-height: 44px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--p-accent);
      font-weight: 600;
    }
    .tx-phone .tx-back::before {
      content: "‹";
      font-size: 20px;
      line-height: 1;
    }
    .tx-phone .tx-meta {
      color: var(--p-muted);
    }
    .tx-phone .tx-tiers li,
    .tx-phone .tx-lines li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border: 1px var(--p-bs) var(--p-line);
      border-radius: var(--p-radius);
    }
    .tx-phone .tx-tiers small {
      display: block;
    }
    .tx-phone .tx-lines li.is-total {
      background: var(--p-card);
      font-size: 15px;
    }
    .tx-phone .tx-left {
      color: var(--p-muted);
      font-size: 12px;
    }
    .tx-phone .tx-cta {
      width: 100%;
      min-height: 48px;
      border: 1px var(--p-bs) var(--p-accent);
      border-radius: var(--p-radius);
      background: var(--p-accent);
      color: var(--p-accent-ink);
      font-weight: 600;
    }
    &[data-fidelity="low"] .tx-phone .tx-cta {
      background: transparent;
      color: var(--p-ink);
    }
    .tx-phone .tx-cta:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }
    .tx-phone .tx-qty {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .tx-phone .tx-qty > div {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .tx-phone .tx-qty button {
      width: 44px;
      height: 44px;
      border: 1px var(--p-bs) var(--p-line);
      border-radius: var(--p-radius);
      background: var(--p-card);
      color: var(--p-ink);
      font-size: 20px;
    }
    .tx-phone .tx-qty button:disabled {
      opacity: 0.4;
    }
    .tx-phone .tx-qty output {
      min-width: 28px;
      text-align: center;
      font-weight: 600;
      font-size: 16px;
    }
    .tx-phone .tx-stage-bar {
      margin: 0 0 8px;
      padding: 4px;
      text-align: center;
      border-radius: 0 0 40px 40px;
      background: var(--p-card);
      color: var(--p-muted);
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .tx-phone .tx-seats {
      display: grid;
      grid-template-columns: 14px repeat(var(--cols), minmax(0, 1fr));
      padding: 4px;
      gap: clamp(2px, 0.5vw, 6px);
      align-items: center;
      margin-bottom: 8px;
      overscroll-behavior: contain;
    }
    .tx-phone .tx-row-label {
      color: var(--p-muted);
      font-size: 11px;
    }
    .tx-phone .tx-seat {
      width: 100%;
      min-width: 44px;
      height: 44px;
      padding: 0;
      border: 1px var(--p-bs) var(--p-line);
      border-radius: calc(var(--p-radius) - 6px) calc(var(--p-radius) - 6px) 4px
        4px;
      background: var(--p-seat-open);
    }
    .tx-phone .tx-seat.is-taken {
      background: var(--p-seat-taken);
      border-color: transparent;
      cursor: not-allowed;
    }
    .tx-phone .tx-seat[aria-pressed="true"] {
      background: var(--p-accent);
      border-color: var(--p-accent);
    }
    .tx-phone .tx-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 14px;
      align-items: center;
      color: var(--p-muted);
      font-size: 12px;
    }
    .tx-phone .tx-legend i {
      display: inline-block;
      width: 12px;
      height: 12px;
      margin-right: 5px;
      border-radius: 3px;
      vertical-align: -1px;
    }
    .tx-phone .tx-legend .a {
      background: var(--p-seat-open);
      border: 1px var(--p-bs) var(--p-line);
    }
    .tx-phone .tx-legend .t {
      background: var(--p-seat-taken);
    }
    .tx-phone .tx-legend .p {
      background: var(--p-accent);
    }
    .tx-phone .tx-sum {
      font-weight: 600;
    }
    .tx-phone .tx-field {
      display: block;
      margin-bottom: 4px;
      color: var(--p-muted);
      font-size: 12px;
    }
    .tx-phone input[name="name"] {
      width: 100%;
      min-height: 44px;
      padding: 0 12px;
      border: 1px var(--p-bs) var(--p-line);
      border-radius: var(--p-radius);
      background: var(--p-bg);
      color: var(--p-ink);
      font: inherit;
      font-size: 16px;
    }
    .tx-phone input[aria-invalid="true"] {
      border-color: #b3261e;
    }
    .tx-phone .tx-err {
      min-height: 18px;
      margin: 4px 0 6px;
      color: #b3261e;
      font-size: 12px;
    }
    .tx-phone .tx-pays {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 12px;
    }
    .tx-phone .tx-pay {
      min-height: 44px;
      border: 1px var(--p-bs) var(--p-line);
      border-radius: var(--p-radius);
      background: var(--p-bg);
      color: var(--p-ink);
      font-size: 13px;
    }
    .tx-phone .tx-pay[aria-pressed="true"] {
      border-color: var(--p-accent);
      box-shadow: inset 0 0 0 1px var(--p-accent);
      font-weight: 600;
    }
    .tx-phone .tx-flash {
      padding: 8px 12px;
      border-radius: var(--p-radius);
      background: var(--p-card);
      color: var(--p-ink);
      font-size: 13px;
    }
    .tx-phone .tx-empty {
      color: var(--p-muted);
    }
    .tx-phone .tx-ticket {
      position: relative;
      display: grid;
      gap: 8px;
      justify-items: center;
      margin-bottom: 12px;
      padding: 12px;
      border: 1px var(--p-bs) var(--p-line);
      border-radius: var(--p-radius);
      background: var(--p-card);
      text-align: center;
    }
    .tx-phone .tx-ticket .tx-art {
      width: 100%;
      height: 44px;
    }
    .tx-phone .tx-ticket-body {
      display: grid;
    }
    .tx-phone .tx-qr {
      width: 100%;
      max-width: 172px;
      height: auto;
      padding: 6px;
      border-radius: 8px;
      background: #fff;
      shape-rendering: crispEdges;
    }
    .tx-phone .tx-ticket.is-used .tx-qr {
      opacity: 0.3;
    }
    .tx-phone .tx-id {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 15px;
      letter-spacing: 0.06em;
    }
    .tx-phone .tx-stamp {
      position: absolute;
      top: 50%;
      left: 50%;
      padding: 4px 12px;
      transform: translate(-50%, -50%) rotate(-12deg);
      border: 2px solid #b3261e;
      border-radius: 6px;
      background: var(--p-bg);
      color: #b3261e;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .tx-phone .tx-door-btn {
      min-height: 44px;
      padding: 0 16px;
      border: 1px var(--p-bs) var(--p-accent);
      border-radius: var(--p-radius);
      background: var(--p-bg);
      color: var(--p-accent);
      font-weight: 600;
    }
    .tx-phone .tx-mini {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      width: 100%;
      min-height: 48px;
      padding: 6px 12px;
      text-align: left;
      border: 1px var(--p-bs) var(--p-line);
      border-radius: var(--p-radius);
      background: var(--p-bg);
      color: var(--p-ink);
    }
    .tx-phone .tx-mini[aria-pressed="true"] {
      border-color: var(--p-accent);
      box-shadow: inset 0 0 0 1px var(--p-accent);
    }

    @media (max-width: 1100px) {
      .tx-main {
        grid-template-columns: minmax(0, 1fr);
      }
      & {
        padding: 14px;
      }
    }

    &,
    * {
      scrollbar-width: thin;
      scrollbar-color: #52647a transparent;
    }
    &::-webkit-scrollbar,
    *::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    &::-webkit-scrollbar-thumb,
    *::-webkit-scrollbar-thumb {
      background: #52647a;
      border-radius: 8px;
    }
    &::-webkit-scrollbar-track,
    *::-webkit-scrollbar-track {
      background: transparent;
    }
    .tx-phone:has(.tx-seats, .tx-qr) {
      height: auto;
    }
    .tx-screen:has(.tx-seats, .tx-qr) {
      overflow: visible;
      max-height: none;
    }
