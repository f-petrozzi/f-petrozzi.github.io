---
import {
  ask,
  meetingSlots,
  prompts,
} from "../../data/demos/usf-campus-concierge";
const reply = ask(prompts[1]);
---

<section
  class="demo demo-usf-campus-concierge"
  data-demo="usf-campus-concierge"
  aria-label="USF Campus Concierge interactive sample"
>
  <header class="toolbar">
    <div>
      <span class="kicker">USF Campus Concierge</span><h2>
        Student support chat
      </h2><p>Custom USF chat for university employees helping students.</p>
    </div>
    <button type="button" data-reset>Reset</button>
  </header>
  <div
    class="chat"
    data-chat
    tabindex="0"
    role="region"
    aria-label="Employee and assistant conversation"
  >
    <article class="message employee">
      <h3>University employee</h3><p data-last-question>{reply.question}</p>
    </article>
    <article class="message assistant">
      <h3>USF assistant</h3>
      <div data-answer aria-live="polite">
        {
          reply.answer.map((part) => (
            <p>
              {part.text} <span>[{part.number}]</span>
            </p>
          ))
        }
      </div>
      <div class="actions" role="group" aria-label="Student follow-up">
        <button type="button" data-action="email" aria-pressed="false"
          >Draft student follow-up</button
        >
        <button type="button" data-action="calendar" aria-pressed="false"
          >Schedule advising meeting</button
        >
      </div>
    </article>
    <section
      class="message action-card"
      data-action-panel="email"
      aria-label="Student email"
      hidden
    >
      <span class="kicker">MCP Gmail</span><h3>Follow-up to the student</h3>
      <form data-email-form>
        <div class="draft-fields">
          <label
            >To<input
              data-email-to
              type="email"
              maxlength="160"
              required
            /></label
          ><label
            >Subject<input
              data-email-subject
              type="text"
              maxlength="200"
              required
            /></label
          >
        </div>
        <label
          >Message<textarea data-email-body rows="6" maxlength="3000" required
          ></textarea></label
        >
        <div class="send-row">
          <button type="submit" class="primary" data-send>Send email</button
          ><span data-email-status role="status">Draft ready for review</span>
        </div>
      </form>
    </section>
    <section
      class="message action-card"
      data-action-panel="calendar"
      aria-label="Advising appointment"
      hidden
    >
      <span class="kicker">MCP Calendar</span><h3>
        Book a 30-minute advising meeting
      </h3><p>April 2026 / Eastern time</p>
      <div class="calendar">
        {
          meetingSlots.map((day) => (
            <div class="calendar-day">
              <strong>{day.day}</strong>
              {day.times.map((time) => (
                <button
                  type="button"
                  data-slot
                  data-date={day.date}
                  data-time={time}
                  aria-pressed="false"
                  aria-label={`Book April ${day.day} at ${time} Eastern`}
                >
                  {time}
                </button>
              ))}
            </div>
          ))
        }
      </div>
      <p data-slot-status role="status">
        Choose an available appointment for the student.
      </p>
    </section>
  </div>
  <form data-question-form class="composer">
    <label
      >Employee question<div class="question-row">
        <input
          data-question
          type="text"
          value={prompts[1]}
          maxlength="280"
          required
          autocomplete="off"
        /><button type="submit" class="primary">Ask</button>
      </div></label
    >
  </form>
  <div class="prompts" role="group" aria-label="Student support questions">
    {
      prompts.map((prompt, i) => (
        <button
          type="button"
          data-prompt={prompt}
          aria-pressed={String(i === 1)}
        >
          {prompt}
        </button>
      ))
    }
  </div>
  <details data-details>
    <summary>University passages and request details</summary>
    <div class="diagnostics">
      <h3>University passages</h3><p data-retrieval-status>
        {reply.citations.length} cited / 12 passages ranked
      </p>
      <div class="passages" data-passages></div>
      <section data-tool hidden aria-label="MCP tool call">
        <h3 data-tool-name></h3><h4>
          Arguments
        </h4><pre><code data-tool-args /></pre><h4>
          Result
        </h4><pre><code data-tool-result /></pre>
      </section>
      <div class="latency">
        <h3>Last request <span data-total></span></h3>{
          (["retrieve", "generate", "tool"] as const).map((key) => (
            <div class="latency-row">
              <>
                <span>
                  {key === "retrieve"
                    ? "Retrieval"
                    : key === "generate"
                      ? "Answer"
                      : "MCP tool"}
                </span>
                <div class="track" aria-hidden="true">
                  <i data-bar={key} />
                </div>
                <output data-duration={key} />
              </>
            </div>
          ))
        }
      </div>
    </div>
  </details>
  <p class="note">
    Invented university passages and student. Answers, retrieval, MCP Gmail
    sends, Calendar bookings and timings are simulated locally.
  </p>
</section>
<script>
  import "../../scripts/demos/usf-campus-concierge";
</script>
<style is:inline>
  .demo-usf-campus-concierge {
    --usf-ink: #20352e;
    --usf-muted: #53695e;
    --usf-line: #d6e2db;
    --usf-green: #006747;
    color-scheme: light;
    background: #ffffff;
    color: var(--usf-ink);
    border: 1px solid var(--usf-line);
    border-radius: 14px;
    padding: clamp(14px, 3vw, 24px);
    font-size: 14px;
    line-height: 1.6;
    min-width: 0;
    max-height: 780px;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: #a1b8ac transparent;
    & * {
      box-sizing: border-box;
      scrollbar-width: thin;
      scrollbar-color: #a1b8ac transparent;
    }
    &::-webkit-scrollbar,
    & ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    &::-webkit-scrollbar-thumb,
    & ::-webkit-scrollbar-thumb {
      background: #a1b8ac;
      border-radius: 6px;
    }
    h2 {
      margin: 3px 0;
      font-size: 23px;
      letter-spacing: -0.025em;
    }
    h3 {
      margin: 0 0 8px;
      font-size: 13px;
      font-weight: 650;
    }
    h4 {
      margin: 10px 0 4px;
      font-size: 13px;
    }
    p {
      margin: 8px 0;
    }
    .toolbar {
      display: flex;
      align-items: start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }
    .toolbar p {
      font-size: 13px;
      color: var(--usf-muted);
      margin: 0;
    }
    .kicker {
      color: var(--usf-green);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 650;
    }
    button,
    input,
    textarea {
      font: inherit;
      color: inherit;
    }
    button {
      min-height: 44px;
      padding: 8px 12px;
      background: #ffffff;
      border: 1px solid var(--usf-line);
      border-radius: 8px;
      cursor: pointer;
      touch-action: manipulation;
    }
    button:hover,
    button[aria-pressed="true"] {
      background: #e9f3ed;
      border-color: var(--usf-green);
    }
    .primary {
      background: var(--usf-green);
      color: #ffffff;
      border-color: var(--usf-green);
    }
    .primary:hover {
      background: #005139;
    }
    button:disabled {
      opacity: 0.6;
      cursor: default;
    }
    :is(button, input, textarea, summary, [tabindex]):focus-visible {
      box-shadow: 0 0 0 2px var(--usf-green);
    }
    .chat {
      height: 410px;
      overflow: auto;
      background: #f5f8f6;
      border: 1px solid var(--usf-line);
      border-radius: 10px;
      padding: 16px;
    }
    .message {
      padding: 14px 16px;
      border: 1px solid var(--usf-line);
      border-radius: 10px;
      max-width: 94%;
      margin: 0 0 14px;
    }
    .employee {
      background: #e6f1eb;
      margin-left: auto;
    }
    .assistant,
    .action-card {
      background: #ffffff;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
    }
    .citation {
      padding: 0 8px;
      color: var(--usf-green);
      font-size: 12px;
    }
    label {
      display: grid;
      gap: 6px;
      min-width: 0;
      font-size: 13px;
    }
    input,
    textarea {
      width: 100%;
      min-width: 0;
      padding: 10px;
      border: 1px solid #9bb0a4;
      background: #ffffff;
      border-radius: 7px;
      font-size: 16px;
    }
    textarea {
      height: 170px;
      resize: vertical;
      max-height: 260px;
    }
    .composer {
      margin: 16px 0 10px;
    }
    .question-row {
      display: flex;
      gap: 8px;
    }
    .question-row input {
      flex: 1;
    }
    .prompts {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .prompts button {
      font-size: 12px;
      text-align: left;
    }
    .draft-fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 10px 0;
    }
    .send-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 12px;
    }
    [data-email-status],
    [data-slot-status] {
      font-size: 12px;
      color: var(--usf-green);
      overflow-wrap: anywhere;
    }
    .calendar {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }
    .calendar-day {
      display: grid;
      gap: 6px;
      min-width: 0;
    }
    .calendar-day button {
      padding: 8px 4px;
    }
    details {
      margin-top: 14px;
      border-top: 1px solid var(--usf-line);
    }
    summary {
      cursor: pointer;
      min-height: 44px;
      padding: 10px 0;
      font-size: 13px;
      color: var(--usf-muted);
    }
    .diagnostics {
      max-height: 260px;
      overflow: auto;
      padding: 12px;
      border: 1px solid var(--usf-line);
      border-radius: 8px;
    }
    .passages {
      display: grid;
      gap: 8px;
    }
    .passages article {
      padding: 12px;
      border: 1px solid var(--usf-line);
      border-radius: 8px;
    }
    .passages article.selected {
      border-color: var(--usf-green);
      background: #e9f3ed;
    }
    .passages h4 {
      margin: 0;
    }
    .passages p,
    .score,
    [data-retrieval-status] {
      font-size: 12px;
      color: var(--usf-muted);
    }
    pre {
      max-width: 100%;
      max-height: 180px;
      overflow: auto;
      padding: 12px;
      background: #f5f8f6;
      border-radius: 6px;
      font-size: 12px;
    }
    [data-tool],
    .latency {
      margin-top: 16px;
    }
    [data-total] {
      color: var(--usf-green);
      margin-left: 10px;
    }
    .latency-row {
      display: grid;
      grid-template-columns: 70px minmax(0, 1fr) 65px;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      margin: 6px 0;
    }
    .track {
      height: 6px;
      background: var(--usf-line);
      border-radius: 6px;
      overflow: hidden;
    }
    .track i {
      display: block;
      height: 100%;
      background: var(--usf-green);
    }
    .note {
      font-size: 12px;
      color: var(--usf-muted);
      margin: 10px 0 0;
    }
    [hidden] {
      display: none !important;
    }
    @media (max-width: 520px) {
      .chat {
        padding: 10px;
      }
      .message {
        max-width: 100%;
        padding: 12px;
      }
      .draft-fields {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  }
</style>
