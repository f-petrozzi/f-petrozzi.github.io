---
import {
  accounts,
  createState,
  days,
  groundedNote,
  money,
  navigation,
  products,
  sources,
  spending,
  spendingGroups,
  transactions,
} from "../../data/demos/orbit";
const initial = createState();
const uid = `orbit-${crypto.randomUUID().slice(0, 8)}`;
// Local paths match Orbit's pinned Lucide vocabulary; no icon runtime.
const icons: Record<string, string> = {
  tasks: '<path d="m4 7 2 2 4-4M13 7h7M4 15l2 2 4-4M13 15h7"/>',
  chat: '<path d="M21 11a8 8 0 0 1-8 8H7l-4 3V11a9 9 0 0 1 18 0Z"/>',
  book: '<rect x="5" y="3" width="15" height="18" rx="2"/><path d="M3 7h4M3 12h4M3 17h4M10 8h6M10 12h6"/>',
  wallet:
    '<rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 8h18M16 12h5v5h-5a2.5 2.5 0 0 1 0-5Z"/>',
};
---

<section
  class="demo demo-orbit"
  data-demo="orbit"
  aria-label="Orbit interactive sample"
>
  <aside class="orbit-sidebar">
    <div class="orbit-brand">
      <span class="orbit-mark" aria-hidden="true"></span><strong>Orbit</strong>
    </div>
    <nav aria-label="Orbit views" role="tablist">
      <span class="orbit-nav-highlight" aria-hidden="true"></span>
      {
        navigation.map((item) => (
          <button
            type="button"
            role="tab"
            id={`${uid}-${item.id}-tab`}
            aria-controls={`${uid}-${item.id}`}
            aria-selected={item.id === "tasks" ? "true" : "false"}
            tabindex={item.id === "tasks" ? 0 : -1}
            data-view={item.id}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[item.icon]}
            />
            <span>{item.label}</span>
          </button>
        ))
      }
    </nav>
    <button type="button" class="orbit-reset" data-reset>Reset</button>
  </aside>
  <div class="orbit-workspace">
    <section
      class="orbit-view"
      role="tabpanel"
      id={`${uid}-tasks`}
      aria-labelledby={`${uid}-tasks-tab`}
      data-panel="tasks"
    >
      <header class="orbit-page-head">
        <h2>Tasks</h2><span>October 2026</span>
      </header>
      <div class="orbit-segments" role="group" aria-label="Task views">
        <button type="button" data-task-view="plan" aria-pressed="true"
          >Plan</button
        >
        <button type="button" data-task-view="all" aria-pressed="false"
          >All</button
        >
        <button type="button" data-task-view="completed" aria-pressed="false"
          >Completed</button
        >
      </div>
      <div class="orbit-list-filters" role="group" aria-label="Task lists">
        {
          ["All lists", "Personal", "Home", "Work"].map((label, index) => (
            <button
              type="button"
              data-list={index ? label : "all"}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {index > 0 && (
                <i
                  class={`orbit-dot orbit-${label.toLowerCase()}`}
                  aria-hidden="true"
                />
              )}
              {label}
            </button>
          ))
        }
      </div>
      <div class="orbit-week" aria-label="Week of October 12">
        {
          ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map(
            (label, index) => (
              <div class:list={["orbit-week-day", { "is-today": index === 4 }]}>
                <b>{12 + index}</b>
                {index >= 4 && index <= 5 && <i aria-hidden="true" />}
              </div>
            ),
          )
        }
      </div>
      <div
        class="orbit-agenda orbit-scroll"
        tabindex="0"
        aria-label="Task agenda"
      >
        <div class="orbit-days">
          {
            days.map((day) => (
              <section
                class:list={["orbit-day", { "is-today": day.id === "today" }]}
                data-day={day.id}
              >
                <header>
                  <>
                    <h3>{day.label}</h3>
                    <span>{day.date}</span>
                  </>
                </header>
                <div class="orbit-task-list" data-task-list={day.id}>
                  {initial.tasks
                    .filter((task) => task.day === day.id)
                    .map((task) => (
                      <article
                        class:list={["orbit-task", { "is-done": task.done }]}
                        data-task={task.id}
                      >
                        <label
                          class={`orbit-check orbit-${task.list.toLowerCase()}`}
                        >
                          <input
                            type="checkbox"
                            checked={task.done}
                            data-complete={task.id}
                            aria-label={`Complete ${task.title}`}
                          />
                          <span aria-hidden="true">✓</span>
                        </label>
                        <details>
                          <summary>
                            <span data-task-title>{task.title}</span>
                            <span class="orbit-edit-symbol" aria-hidden="true">
                              ⌄
                            </span>
                          </summary>
                          <label class="orbit-field">
                            Planned day
                            <select data-move={task.id}>
                              {days.map((option) => (
                                <option
                                  value={option.id}
                                  selected={option.id === task.day}
                                >
                                  {option.label}
                                </option>
                              ))}
                            </select>
                          </label>
                        </details>
                      </article>
                    ))}
                </div>
                <p class="orbit-empty" data-task-empty hidden>
                  No tasks
                </p>
              </section>
            ))
          }
        </div>
      </div>
      <form class="orbit-capture" data-capture>
        <label class="orbit-sr"
          >New task<input
            name="task"
            type="text"
            maxlength="120"
            required
            autocomplete="off"
            placeholder="Add a task…"
          /></label
        >
        <label class="orbit-sr"
          >Planned day<select name="day"
            >{
              days.map((day) => <option value={day.id}>{day.label}</option>)
            }</select
          ></label
        >
        <button type="submit" class="orbit-primary" aria-label="Add task"
          >↑</button
        >
      </form>
    </section>
    <section
      class="orbit-view"
      role="tabpanel"
      id={`${uid}-chat`}
      aria-labelledby={`${uid}-chat-tab`}
      data-panel="chat"
      hidden
    >
      <header class="orbit-page-head"><h2>Chat</h2><span>Codex</span></header>
      <div class="orbit-chat-layout">
        <aside class="orbit-chat-picker orbit-card">
          <h3>Projects</h3><details open>
            <summary>Reading room</summary><button
              type="button"
              aria-pressed="true"
              class="orbit-session"
              >Build the catalog<small>Codex / Orbit</small></button
            >
          </details>
        </aside>
        <div class="orbit-conversation orbit-card">
          <header class="orbit-pane-head">
            <strong>Build the catalog</strong><button
              type="button"
              data-preview-toggle
              aria-pressed="true">Preview</button
            >
          </header>
          <div
            class="orbit-transcript orbit-scroll"
            data-transcript
            tabindex="0"
            aria-label="Project conversation"
          >
            <article class="orbit-message is-user">
              <span>You</span><p>
                Build a reading room catalog with availability and a reservation
                button.
              </p>
            </article>
            <article class="orbit-message">
              <span><i class="orbit-mark" aria-hidden="true"></i>Orbit</span><p>
                The catalog is ready. The preview has three books, availability,
                and a reservation action for each title.
              </p><button type="button" class="orbit-file" data-open-preview
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                  ><path d="M4 3h10l6 6v12H4ZM14 3v6h6M8 14h8M8 17h5"
                  ></path></svg
                ><span>catalog.html<small>App preview</small></span></button
              >
            </article>
          </div>
          <form class="orbit-chat-composer" data-chat-form>
            <label class="orbit-sr"
              >Message<input
                name="message"
                type="text"
                maxlength="200"
                required
                autocomplete="off"
                value="Make the cards more compact"
              /></label
            >
            <div>
              <span>Codex</span><button
                class="orbit-primary"
                type="submit"
                aria-label="Send message">↑</button
              >
            </div>
          </form>
        </div>
        <section
          class="orbit-preview orbit-card"
          data-preview
          aria-label="Catalog app preview"
        >
          <header class="orbit-pane-head">
            <strong>Preview</strong><button
              type="button"
              data-preview-size
              aria-pressed="false">Phone</button
            ><button type="button" data-preview-close aria-label="Close preview"
              >Close</button
            >
          </header>
          <div
            class="orbit-preview-scroll orbit-scroll"
            tabindex="0"
            aria-label="Reading room app"
          >
            <div class="orbit-app" data-app data-density="comfortable">
              <p class="orbit-app-label">THE READING ROOM</p><h3>
                A little space<br />for a good book.
              </h3><p>Saturday, 10 am to 2 pm</p>
              <div class="orbit-books">
                {
                  [
                    "Ways of Seeing",
                    "A Field Guide to Trees",
                    "The Quiet Garden",
                  ].map((title, index) => (
                    <article>
                      <>
                        <div
                          class={`orbit-book-cover orbit-cover-${index}`}
                          aria-hidden="true"
                        >
                          <span>{["SEE", "GROW", "REST"][index]}</span>
                        </div>
                        <div>
                          <>
                            <h4>{title}</h4>
                            <small data-availability>Available</small>
                            <button
                              type="button"
                              data-reserve={index}
                              aria-pressed="false"
                            >
                              Reserve
                            </button>
                          </>
                        </div>
                      </>
                    </article>
                  ))
                }
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>
    <section
      class="orbit-view"
      role="tabpanel"
      id={`${uid}-library`}
      aria-labelledby={`${uid}-library-tab`}
      data-panel="library"
      hidden
    >
      <header class="orbit-page-head">
        <h2>Library</h2><span>Reading room</span>
      </header>
      <div
        class="orbit-library-tabs orbit-segments"
        role="group"
        aria-label="Notebook panes"
      >
        {
          ["Sources", "Chat", "Studio"].map((label, index) => (
            <button
              type="button"
              data-library-tab={label.toLowerCase()}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {label}
            </button>
          ))
        }
      </div>
      <div class="orbit-notebook">
        <section
          class="orbit-card orbit-library-pane orbit-scroll"
          data-library-pane="sources"
          tabindex="0"
          aria-label="Notebook sources"
        >
          <h3>Sources</h3><div class="orbit-sources">
            {
              sources.map((source) => (
                <article>
                  <>
                    <label class="orbit-source-use">
                      <>
                        <input
                          type="checkbox"
                          checked
                          data-source={source.id}
                        />
                        <span class="orbit-sr-text">Use {source.title}</span>
                      </>
                    </label>
                    <button type="button" data-read-source={source.id}>
                      <>
                        <strong>{source.title}</strong>
                        <small>{source.kind}</small>
                      </>
                    </button>
                  </>
                </article>
              ))
            }
          </div><div class="orbit-source-reader" data-source-reader>
            <h4>{sources[0].title}</h4><p>{sources[0].text}</p>
          </div>
        </section>
        <section
          class="orbit-card orbit-library-pane orbit-library-chat"
          data-library-pane="chat"
        >
          <h3>Chat</h3><div
            class="orbit-scroll"
            tabindex="0"
            aria-label="Notebook conversation"
          >
            <article class="orbit-message is-user">
              <span>You</span><p>What should the first release include?</p>
            </article><article class="orbit-message">
              <span>Orbit</span><div data-grounded-answer>
                {
                  groundedNote(initial.selected).map((note, index) => (
                    <p>
                      {note.text}{" "}
                      <button
                        type="button"
                        class="orbit-citation"
                        data-citation={note.source}
                        aria-label={`Read source: ${note.title}`}
                      >
                        [{index + 1}]
                      </button>
                    </p>
                  ))
                }
              </div>
            </article>
          </div><button type="button" class="orbit-secondary" data-generate
            >Summarize selected sources</button
          >
        </section>
        <section
          class="orbit-card orbit-library-pane orbit-scroll"
          data-library-pane="studio"
          tabindex="0"
          aria-label="Studio notes"
        >
          <h3>Studio</h3><article class="orbit-studio-note">
            <span class="orbit-note-type">Grounded note</span><h4>
              First release
            </h4><div data-studio-note>
              {
                groundedNote(initial.selected).map((note) => (
                  <p>
                    {note.text}
                    <small>{note.title}</small>
                  </p>
                ))
              }
            </div>
          </article><button type="button" class="orbit-secondary" data-save-note
            >Save answer to Studio</button
          >
        </section>
      </div>
    </section>
    <section
      class="orbit-view"
      role="tabpanel"
      id={`${uid}-finance`}
      aria-labelledby={`${uid}-finance-tab`}
      data-panel="finance"
      hidden
    >
      <header class="orbit-page-head">
        <h2>Finances</h2><span>October 2026</span>
      </header>
      <div class="orbit-segments" role="group" aria-label="Finance views">
        <button type="button" data-fin-view="overview" aria-pressed="true"
          >Overview</button
        ><button type="button" data-fin-view="accounts" aria-pressed="false"
          >Accounts</button
        ><button type="button" data-fin-view="spending" aria-pressed="false"
          >Spending</button
        ><button type="button" data-fin-view="wishlist" aria-pressed="false"
          >Wishlist</button
        >
      </div>
      <div
        class="orbit-fin-body orbit-scroll"
        tabindex="0"
        aria-label="Finance records"
      >
        <section data-fin-panel="overview">
          <div class="orbit-fin-summary orbit-card">
            <div>
              <span>Spent</span><strong class="orbit-amount"
                >{money(spending())}</strong
              ><small>October 1 to 16</small>
            </div><div>
              <span>Income</span><strong>{money(240000)}</strong><span
                >Net income</span
              ><strong>{money(240000 - spending())}</strong>
            </div>
          </div><div class="orbit-fin-grid">
            <button
              type="button"
              class="orbit-card orbit-shelf"
              data-fin-view="accounts"
              ><span class="orbit-shelf-orb" aria-hidden="true">$</span><h3>
                Accounts
              </h3><strong
                >{
                  money(
                    accounts
                      .filter((account) => account.type === "Cash")
                      .reduce((sum, account) => sum + account.cents, 0),
                  )
                }</strong
              ><small>Cash in 2 accounts</small></button
            ><button
              type="button"
              class="orbit-card orbit-shelf"
              data-fin-view="spending"
              ><span class="orbit-shelf-orb" aria-hidden="true">↗</span><h3>
                Spending
              </h3><strong>Home</strong><small>Largest spending family</small
              ></button
            ><button
              type="button"
              class="orbit-card orbit-shelf"
              data-fin-view="wishlist"
              ><span class="orbit-shelf-orb" aria-hidden="true">♡</span><h3>
                Wishlist
              </h3><strong>3 items</strong><small>Reading corner</small></button
            >
          </div>
        </section>
        <section data-fin-panel="accounts" hidden>
          <h3>Accounts</h3><div class="orbit-account-list orbit-card">
            {
              accounts.map((account) => (
                <article>
                  <>
                    <span class="orbit-bank-coin" aria-hidden="true">
                      {account.name[0]}
                    </span>
                    <div>
                      <>
                        <strong>{account.name}</strong>
                        <small>
                          {account.type} / {account.read}
                        </small>
                      </>
                    </div>
                    <strong>{money(account.cents)}</strong>
                  </>
                </article>
              ))
            }
          </div>
        </section>
        <section data-fin-panel="spending" hidden>
          <h3>Spending by family</h3><div class="orbit-spending orbit-card">
            {
              spendingGroups().map((group) => (
                <button
                  type="button"
                  data-spending={group.name}
                  aria-pressed="false"
                >
                  <>
                    <span>
                      {group.name}
                      <strong>{money(group.cents)}</strong>
                    </span>
                    <i>
                      <b
                        style={`width:${(group.cents / spendingGroups()[0].cents) * 100}%`}
                      />
                    </i>
                  </>
                </button>
              ))
            }
          </div><div class="orbit-transactions" data-transactions>
            {
              transactions.map((row) => (
                <article>
                  <>
                    <strong>{row.merchant}</strong>
                    <small>{row.category}</small>
                    <span>{money(row.cents)}</span>
                  </>
                </article>
              ))
            }
          </div>
        </section>
        <section data-fin-panel="wishlist" hidden>
          <h3>Wishlist</h3><div class="orbit-wishlist">
            {
              products.map((product) => (
                <details class="orbit-product orbit-card">
                  <>
                    <summary>
                      <>
                        <span
                          class={`orbit-product-art orbit-art-${product.shape}`}
                          aria-hidden="true"
                        >
                          <>
                            <i />
                            <b />
                          </>
                        </span>
                        <small>{product.store}</small>
                        <h4>{product.name}</h4>
                        <strong>{money(product.cents)}</strong>
                      </>
                    </summary>
                    <div class="orbit-product-detail">
                      <>
                        <dl>
                          <>
                            <div>
                              <>
                                <dt>Oct 2</dt>
                                <dd>{money(product.previous)}</dd>
                              </>
                            </div>
                            <div>
                              <>
                                <dt>Oct 16</dt>
                                <dd>{money(product.cents)}</dd>
                              </>
                            </div>
                            <div>
                              <>
                                <dt>Target price</dt>
                                <dd>{money(product.target)}</dd>
                              </>
                            </div>
                          </>
                        </dl>
                        <button
                          type="button"
                          class="orbit-secondary"
                          data-purchase={product.id}
                          aria-pressed="false"
                        >
                          Mark purchased
                        </button>
                      </>
                    </div>
                  </>
                </details>
              ))
            }
          </div>
        </section>
      </div>
    </section>
    <div
      class="orbit-status"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-status
    >
    </div>
  </div>
  <p class="orbit-note">
    Invented data. Agent replies, app changes, bank readings, and product prices
    are simulated locally.
  </p>
</section>
<script>
  import "../../scripts/demos/orbit";
</script>
<style is:inline>
  .demo-orbit {
    --orbit-cloud: #edf1f3;
    --orbit-glass: #ffffff80;
    --orbit-ink: #29313a;
    --orbit-slate: #5f6a74;
    --orbit-sage: #4e766e;
    --orbit-blue: #577994;
    --orbit-line: #4b5b6e1f;
    --orbit-steel: #8aa5b8;
    --orbit-selected: #ffffffd9;
    --orbit-shadow: inset 0 1px 0 #fff, 0 2px 8px #344b590f;
    --orbit-ease: cubic-bezier(0.22, 0.75, 0.25, 1);
    color-scheme: light;
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 20px;
    margin: 28px 0;
    padding: 20px;
    border: 1px solid #fff9;
    border-radius: 28px;
    background:
      radial-gradient(ellipse at 90% 0%, #dce7ed, transparent 60%),
      linear-gradient(130deg, #e8ecf0, #f4f6f7 42%, #e1e9e8);
    color: var(--orbit-ink);
    font: inherit;
    font-size: 14px;
    line-height: 1.5;
    isolation: isolate;

    &,
    * {
      box-sizing: border-box;
      scrollbar-width: thin;
      scrollbar-color: #9aaebc transparent;
    }
    &::-webkit-scrollbar,
    *::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    &::-webkit-scrollbar-thumb,
    *::-webkit-scrollbar-thumb {
      border-radius: 8px;
      background: #9aaebc;
    }
    &::-webkit-scrollbar-track,
    *::-webkit-scrollbar-track {
      background: transparent;
    }
    [hidden] {
      display: none !important;
    }
    h2,
    h3,
    h4,
    p {
      margin: 0;
      color: inherit;
    }
    h2 {
      font-size: 30px;
      font-weight: 500;
      letter-spacing: -1px;
      line-height: 1.2;
    }
    h3 {
      font-size: 16px;
      font-weight: 600;
      letter-spacing: -0.25px;
    }
    h4 {
      font-size: 14px;
      font-weight: 600;
      line-height: 1.4;
    }
    small {
      font-size: 12px;
      color: var(--orbit-slate);
    }
    button,
    input,
    select {
      font: inherit;
      color: inherit;
    }
    button {
      min-height: 44px;
      padding: 8px 12px;
      border: 1px solid transparent;
      border-radius: 12px;
      background: transparent;
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    button:disabled {
      cursor: default;
      opacity: 0.6;
    }
    input,
    select {
      min-width: 0;
      border: 1px solid var(--orbit-line);
      border-radius: 12px;
      padding: 10px;
      background: #f5f8fa;
      font-size: 16px;
    }
    select {
      max-width: 100%;
    }
    summary {
      cursor: pointer;
      touch-action: manipulation;
    }
    .orbit-sr-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .orbit-sr {
      font-size: 0;
      min-width: 0;
    }
    .orbit-sr input,
    .orbit-sr select {
      font-size: 16px;
      width: 100%;
    }
    .orbit-scroll {
      overflow: auto;
      overscroll-behavior: contain;
    }
    .orbit-sidebar {
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding: 20px 10px 10px;
      border: 1px solid #ffffffdc;
      border-radius: 28px;
      background: var(--orbit-glass);
      box-shadow: var(--orbit-shadow);
    }
    .orbit-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 8px;
    }
    .orbit-brand strong {
      font-size: 23px;
      font-weight: 650;
      letter-spacing: -1px;
    }
    .orbit-mark {
      position: relative;
      display: inline-block;
      flex: none;
      width: 28px;
      height: 28px;
      border: 1px solid #fff;
      border-radius: 50%;
      background:
        radial-gradient(circle at 30% 22%, #fff, transparent 55%),
