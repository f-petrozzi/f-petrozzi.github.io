---
import { trials, bestTrial } from "../../data/demos/optuna";
const best = bestTrial(trials.slice(0, 6))!;
---

<section
  class="demo demo-optuna"
  data-demo="optuna"
  aria-label="Optuna interactive sample"
>
  <h2>Churn model · tuning study</h2>
  <div class="columns">
    <article class="card">
      <h3>Optimization history</h3><div data-history></div><p class="muted">
        ● Completed · × Pruned · Line: best completed loss
      </p>
    </article>
    <article class="card">
      <h3>Parameter importance</h3><div data-importance></div><p>
        Best validation loss <strong class="score" data-best
          >{best.loss.toFixed(4)}</strong
        >
      </p><p data-config></p>
    </article>
  </div>
  <div class="toolbar">
    <button type="button" data-play aria-pressed="false">Play</button><button
      type="button"
      data-step>Step</button
    ><button type="button" data-reset>Reset</button>
  </div>
  <div aria-live="polite">
    <p data-status>6 / 30 trials</p><p class="muted" data-latest></p>
  </div>
  <p class="note">
    A seeded local replay, not an Optuna or PyTorch run. Importance uses
    relative grouped loss variance, not Optuna’s fANOVA estimator.
  </p>
</section>
<script>
  import "../../scripts/demos/optuna";
</script>
<style>
  .demo-optuna {
    margin: 28px 0;
    padding: clamp(14px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.55;
    min-width: 0;
  }
  .demo-optuna .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .demo-optuna .card {
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .demo-optuna h2 {
    margin: 0 0 14px;
    font-size: 22px;
    letter-spacing: -0.025em;
  }
  .demo-optuna h3 {
    margin: 0 0 10px;
    font-size: 16px;
  }
  .demo-optuna p {
    margin: 12px 0;
  }
  .demo-optuna .muted,
  .demo-optuna .note {
    color: var(--muted);
  }
  .demo-optuna .note {
    font-size: 12px;
    margin-bottom: 0;
  }
  .demo-optuna .score {
    display: block;
    color: var(--accent);
    font-size: clamp(28px, 5vw, 42px);
    line-height: 1.2;
    margin: 10px 0;
  }
  .demo-optuna .toolbar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    margin: 18px 0;
  }
  .demo-optuna button,
  .demo-optuna select {
    font: inherit;
    min-height: 44px;
    padding: 8px 12px;
    background: var(--bg);
    color: var(--ink);
    border: 1px solid var(--muted);
    border-radius: 8px;
    max-width: 100%;
  }
  .demo-optuna button {
    cursor: pointer;
    touch-action: manipulation;
  }
  .demo-optuna button[aria-pressed="true"] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
  }
  .demo-optuna button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .demo-optuna :is(button, input, select):focus-visible {
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 0 6px var(--accent);
  }
  .demo-optuna label {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .demo-optuna .inputs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 18px 0;
  }
  .demo-optuna input,
  .demo-optuna select {
    font-size: 16px;
    accent-color: var(--accent);
  }
  .demo-optuna input[type="range"] {
    width: 100%;
    min-height: 44px;
    margin: 0;
  }
  .demo-optuna input[type="checkbox"] {
    width: 22px;
    height: 22px;
    margin: 10px;
  }
  .demo-optuna .check {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .demo-optuna .scroll {
    overflow-x: auto;
    max-width: 100%;
  }
  .demo-optuna :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .demo-optuna :global(th),
  .demo-optuna :global(td) {
    padding: 9px 6px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .demo-optuna :global(th) {
    font-weight: 500;
  }
  .demo-optuna :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .demo-optuna :global(svg text) {
    fill: var(--muted);
    font:
      12px system-ui,
      sans-serif;
  }
  .demo-optuna :global(.axis) {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1;
  }
  .demo-optuna :global(.series) {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  .demo-optuna :global(.point) {
    fill: var(--accent);
  }
  .demo-optuna :global(.secondary) {
    fill: var(--muted);
  }
  .demo-optuna :global(.selected) {
    stroke: var(--accent);
    stroke-width: 2.5;
    fill: none;
  }
  .demo-optuna :global(.branch) {
    stroke: var(--muted);
    stroke-width: 1;
    fill: none;
  }
  .demo-optuna :global(g rect) {
    fill: var(--bg);
  }
  .demo-optuna :global(g text) {
    stroke: none;
    text-anchor: middle;
    font-size: 10px;
  }
  @media (max-width: 680px) {
    .demo-optuna .columns {
      grid-template-columns: 1fr;
    }
    .demo-optuna .inputs {
      grid-template-columns: 1fr 1fr;
    }
    .demo-optuna .card {
      padding: 12px;
    }
  }
  @media (max-width: 380px) {
    .demo-optuna .inputs {
      grid-template-columns: 1fr;
    }
  }
</style>
