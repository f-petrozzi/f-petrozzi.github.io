---
import { trials, bestTrial } from "../../data/demos/optuna";
const best = bestTrial(trials)!;
---

<section
  class="demo demo-optuna"
  data-demo="optuna"
  aria-label="Optuna interactive sample"
>
  <header class="study-heading">
    <h2>Churn model tuning study</h2><a
      href="https://www.youtube.com/watch?v=nWm1OeqH004"
      target="_blank"
      rel="noopener noreferrer"
      >Recorded presentation<svg viewBox="0 0 16 16" aria-hidden="true"
        ><path d="M4 12 12 4M4 4h8v8"></path></svg
      ></a
    >
  </header>
  <div class="columns">
    <article class="card">
      <h3>Optimization history</h3><div data-history></div><div class="legend">
        <span>● Completed</span><span>× Pruned</span><span
          >Line: best completed loss</span
        >
      </div>
    </article>
    <article class="card">
      <h3>Parameter importance</h3><div data-importance></div><p>
        Best validation loss <strong class="score" data-best
          >{best.loss.toFixed(4)}</strong
        >
      </p><p data-config></p>
    </article>
  </div>
  <div class="toolbar">
    <button type="button" data-play aria-pressed="false">Play</button><button
      type="button"
      data-step>Step</button
    ><button type="button" data-reset>Reset</button>
  </div>
  <div aria-live="polite">
    <p data-status>30 / 30 trials</p><p class="muted" data-latest></p>
  </div>
  <p class="note">
    A seeded local replay, not an Optuna or PyTorch run. Importance uses
    relative grouped loss variance, not Optuna's fANOVA estimator.
  </p>
</section>
<script>
  import "../../scripts/demos/optuna";
</script>
<style is:inline>
  .demo-optuna {
    --demo-bg: #ffffff;
    --demo-ink: #182b39;
    --demo-muted: #526575;
    --demo-line: #d7e1e8;
    --demo-accent: #4059ad;
    color-scheme: light;
    margin: 28px 0;
    padding: clamp(14px, 3vw, 28px);
    border: 1px solid var(--demo-line);
    border-radius: 16px;
    background: #f5f8fa;
    color: var(--demo-ink);
    font-size: 14px;
    line-height: 1.55;
    min-width: 0;
    scrollbar-width: thin;
    scrollbar-color: #a4b5c2 transparent;
    & * {
      box-sizing: border-box;
      scrollbar-width: thin;
      scrollbar-color: #a4b5c2 transparent;
    }
    &::-webkit-scrollbar,
    & ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    &::-webkit-scrollbar-thumb,
    & ::-webkit-scrollbar-thumb {
      background: #a4b5c2;
      border-radius: 6px;
    }
    .columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    .card {
      min-width: 0;
      padding: 18px;
      border: 1px solid var(--demo-line);
      border-radius: 12px;
      background: var(--demo-bg);
    }
    h2 {
      margin: 0 0 14px;
      font-size: 22px;
      letter-spacing: -0.025em;
    }
    h3 {
      margin: 0 0 10px;
      font-size: 16px;
    }
    p {
      margin: 12px 0;
    }
    .muted,
    .note {
      color: var(--demo-muted);
    }
    .note {
      font-size: 12px;
      margin-bottom: 0;
    }
    .score {
      display: block;
      color: var(--demo-accent);
      font-size: clamp(28px, 5vw, 42px);
      line-height: 1.2;
      margin: 10px 0;
    }
    .toolbar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
      margin: 18px 0;
    }
    button,
    select {
      font: inherit;
      min-height: 44px;
      padding: 8px 12px;
      background: var(--demo-bg);
      color: var(--demo-ink);
      border: 1px solid var(--demo-muted);
      border-radius: 8px;
      max-width: 100%;
    }
    button,
    summary {
      cursor: pointer;
      touch-action: manipulation;
    }
    button[aria-pressed="true"] {
      border-color: var(--demo-accent);
      box-shadow: inset 0 0 0 1px var(--demo-accent);
      color: var(--demo-accent);
    }
    button:disabled {
      opacity: 0.5;
      cursor: default;
    }
    :is(button, input, select, summary, a, [tabindex]):focus-visible {
      box-shadow: 0 0 0 2px var(--demo-accent);
    }
    label {
      display: grid;
      gap: 6px;
      min-width: 0;
    }
    .inputs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin: 18px 0;
    }
    input,
    select {
      font-size: 16px;
      accent-color: var(--demo-accent);
    }
    input[type="range"] {
      width: 100%;
      min-height: 44px;
      margin: 0;
    }
    input[type="checkbox"] {
      width: 22px;
      height: 22px;
      margin: 10px;
    }
    .check {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .scroll {
      overflow: auto;
      max-width: 100%;
      max-height: 240px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    th,
    td {
      padding: 9px 6px;
      border-bottom: 1px solid var(--demo-line);
      text-align: left;
    }
    th {
      font-weight: 500;
    }
    svg {
      display: block;
      width: 100%;
      height: auto;
    }
    svg text {
      fill: var(--demo-muted);
      font-family: inherit;
      font-size: 12px;
    }
    .axis {
      fill: none;
      stroke: var(--demo-muted);
      stroke-width: 1;
    }
    .series {
      fill: none;
      stroke: var(--demo-accent);
      stroke-width: 2.5;
    }
    .point {
      fill: var(--demo-accent);
    }
    .selected {
      stroke: var(--demo-accent);
      stroke-width: 2.5;
      fill: none;
    }
    .branch {
      stroke: var(--demo-muted);
      stroke-width: 1;
      fill: none;
    }
    g rect {
      fill: var(--demo-bg);
    }
    g text {
      stroke: none;
      text-anchor: middle;
    }

    .columns {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
    .study-heading {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .study-heading h2 {
      margin: 0;
    }
    .study-heading a {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      color: var(--demo-accent);
      min-height: 44px;
    }
    .study-heading a svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
    }
    [data-history],
    [data-importance] {
      min-width: 0;
    }
    [data-history] svg,
    [data-importance] svg {
      height: auto;
      max-height: 250px;
    }
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 16px;
      color: var(--demo-muted);
      font-size: 12px;
    }
    [data-config] {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 12px;
      color: var(--demo-muted);
      font-size: 12px;
    }
    [data-config] span {
      display: block;
    }
    [data-latest] {
      min-height: 44px;
      font-size: 12px;
    }

    @media (max-width: 680px) {
      .columns {
        grid-template-columns: 1fr;
      }
      .inputs {
        grid-template-columns: 1fr 1fr;
      }
      .card {
        padding: 12px;
      }
    }
    @media (max-width: 380px) {
      .inputs {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
