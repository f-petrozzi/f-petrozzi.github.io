<section
  class="demo demo-todoo-app"
  data-demo="todoo-app"
  aria-label="Todoo interactive sample"
>
  <div class="td-stage">
    <div class="td-phone">
      <div class="td-island" aria-hidden="true"></div>
      <div class="td-status" data-status aria-hidden="true">
        <span class="td-clock" data-clock>9:41</span>
        <span class="td-status-icons">
          <svg viewBox="0 0 18 12" width="18" height="12" fill="currentColor"
            ><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect
              x="5"
              y="5.5"
              width="3"
              height="6.5"
              rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"
            ></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg
          >
          <svg
            viewBox="0 0 26 12"
            width="26"
            height="12"
            fill="none"
            stroke="currentColor"
            ><rect x="0.5" y="0.5" width="22" height="11" rx="3.5" opacity=".5"
            ></rect><rect
              x="2"
              y="2"
              width="17"
              height="8"
              rx="2"
              fill="currentColor"
              stroke="none"></rect><path
              d="M24 4v4"
              stroke-linecap="round"
              opacity=".5"></path></svg
          >
        </span>
      </div>
      <div class="td-screen" data-screen></div>
      <div
        class="td-layer td-layer-alarm"
        data-alarm
        hidden
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="td-alert-title"
      >
      </div>
      <div
        class="td-layer td-layer-siri"
        data-siri
        hidden
        role="dialog"
        aria-modal="true"
        aria-label="Siri"
      >
      </div>
      <p class="td-toast" role="status" aria-live="polite" data-toast></p>
      <span class="td-home" aria-hidden="true"></span>
    </div>

    <div class="td-side">
      <div class="td-side-actions">
        <button type="button" class="td-btn td-btn-primary" data-siri-open
          >Siri shortcut</button
        >
        <button type="button" class="td-btn" data-reset>Reset</button>
      </div>
      <p class="td-note">
        Generate stands in for the OpenAI call with a fixed local generator.
      </p>
    </div>
  </div>
</section>

<script>
  import "../../scripts/demos/todoo-app";
</script>

<style>
  .demo-todoo-app {
