---
import {
  observations,
  predictorNames,
  regress,
  solveProduction,
} from "../../data/demos/business-statistics";
const fit = regress(observations, [0, 1, 2]);
---

<section
  class="demo demo-business-statistics"
  data-demo="business-statistics"
  aria-label="Business Statistics interactive sample"
>
  <h2>Fit the data. Allocate resources.</h2>
  <form>
    <div class="columns">
      <article class="card">
        <h3>Medical charges / least squares</h3><p aria-live="polite">
          R² <strong class="score" data-r2>{fit.r2.toFixed(3)}</strong>
        </p><div data-residuals></div><div class="scroll">
          <table>
            <thead
              ><tr
                ><th scope="col">Coefficient</th><th scope="col"
                  >Estimate ($)</th
                ></tr
              ></thead
            ><tbody data-coefficients></tbody>
          </table>
        </div><fieldset>
          <legend>Predictors</legend>{
            predictorNames.map((name, i) => (
              <label class="check">
                <input type="checkbox" data-predictor value={i} checked />
                {name}
              </label>
            ))
          }
        </fieldset><details>
          <summary>{observations.length} observations</summary><div
            class="scroll"
          >
            <table>
              <thead
                ><tr
                  >{
                    ["Age", "BMI", "Smoker", "Charges ($)"].map((name) => (
                      <th scope="col">{name}</th>
                    ))
                  }</tr
                ></thead
              ><tbody
                >{
                  observations.map((row) => (
                    <tr>
                      {[...row.predictors, row.charges].map((v) => (
                        <td>{v}</td>
                      ))}
                    </tr>
                  ))
                }</tbody
              >
            </table>
          </div>
        </details>
      </article>
      <article class="card">
        <h3>Production / linear programming</h3><p>
          Maximum profit <strong class="score" data-profit
            >${solveProduction(70, 80).profit.toFixed(2)}</strong
          >
        </p><div data-region></div><p data-optimum aria-live="polite"></p><p
          class="muted"
        >
          Maximize $40A + $30B, with A, B ≥ 0.<br />Solid: 2A + B ≤ labor hours.<br
          />Dashed: A + 2B ≤ material units.
        </p><label
          >Labor <output data-labor>70 hours</output><input
            type="range"
            name="labor"
            min="20"
            max="100"
            value="70"
          /></label
        ><label
          >Material <output data-material>80 units</output><input
            type="range"
            name="material"
            min="20"
            max="100"
            value="80"
          /></label
        ><p class="muted">
          Continuous quantities; optimum evaluated at feasible vertices.
        </p>
      </article>
    </div>
  </form>
  <div class="toolbar"><button type="button" data-reset>Reset</button></div>
  <p class="note">
    Invented charges and production resources, mirroring the R regression and
    Excel Solver exercises. Calculations run locally.
  </p>
</section>
<script>
  import "../../scripts/demos/business-statistics";
</script>
<style is:inline>
  .demo-business-statistics {
    --demo-bg: #ffffff;
    --demo-ink: #182b39;
    --demo-muted: #526575;
    --demo-line: #d7e1e8;
    --demo-accent: #216d58;
    color-scheme: light;
    margin: 28px 0;
    padding: clamp(14px, 3vw, 28px);
    border: 1px solid var(--demo-line);
    border-radius: 16px;
    background: #f5f8fa;
    color: var(--demo-ink);
    font-size: 14px;
    line-height: 1.55;
    min-width: 0;
    max-height: 780px;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: #a4b5c2 transparent;
    & * {
      box-sizing: border-box;
      scrollbar-width: thin;
      scrollbar-color: #a4b5c2 transparent;
    }
    &::-webkit-scrollbar,
    & ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    &::-webkit-scrollbar-thumb,
    & ::-webkit-scrollbar-thumb {
      background: #a4b5c2;
      border-radius: 6px;
    }
    .columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    .card {
      min-width: 0;
      padding: 18px;
      border: 1px solid var(--demo-line);
      border-radius: 12px;
      background: var(--demo-bg);
    }
    h2 {
      margin: 0 0 14px;
      font-size: 22px;
      letter-spacing: -0.025em;
    }
    h3 {
      margin: 0 0 10px;
      font-size: 16px;
    }
    p {
      margin: 12px 0;
    }
    .muted,
    .note {
      color: var(--demo-muted);
    }
    .note {
      font-size: 12px;
      margin-bottom: 0;
    }
    .score {
      display: block;
      color: var(--demo-accent);
      font-size: clamp(28px, 5vw, 42px);
      line-height: 1.2;
      margin: 10px 0;
    }
    .toolbar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
      margin: 18px 0;
    }
    button,
    select {
      font: inherit;
      min-height: 44px;
      padding: 8px 12px;
      background: var(--demo-bg);
      color: var(--demo-ink);
      border: 1px solid var(--demo-muted);
      border-radius: 8px;
      max-width: 100%;
    }
    button,
    summary {
      cursor: pointer;
      touch-action: manipulation;
    }
    button[aria-pressed="true"] {
      border-color: var(--demo-accent);
      box-shadow: inset 0 0 0 1px var(--demo-accent);
      color: var(--demo-accent);
    }
    button:disabled {
      opacity: 0.5;
      cursor: default;
    }
    :is(button, input, select, summary, a, [tabindex]):focus-visible {
      box-shadow: 0 0 0 2px var(--demo-accent);
    }
    label {
      display: grid;
      gap: 6px;
      min-width: 0;
    }
    .inputs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin: 18px 0;
    }
    input,
    select {
      font-size: 16px;
      accent-color: var(--demo-accent);
    }
    input[type="range"] {
      width: 100%;
      min-height: 44px;
      margin: 0;
    }
    input[type="checkbox"] {
      width: 22px;
      height: 22px;
      margin: 10px;
    }
    .check {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .scroll {
      overflow: auto;
      max-width: 100%;
      max-height: 240px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    th,
    td {
      padding: 9px 6px;
      border-bottom: 1px solid var(--demo-line);
      text-align: left;
    }
    th {
      font-weight: 500;
    }
    svg {
      display: block;
      width: 100%;
      height: auto;
    }
    svg text {
      fill: var(--demo-muted);
      font-family: inherit;
      font-size: 12px;
    }
    .axis {
      fill: none;
      stroke: var(--demo-muted);
      stroke-width: 1;
    }
    .series {
      fill: none;
      stroke: var(--demo-accent);
      stroke-width: 2.5;
    }
    .point {
      fill: var(--demo-accent);
    }
    .selected {
      stroke: var(--demo-accent);
      stroke-width: 2.5;
      fill: none;
    }
    .branch {
      stroke: var(--demo-muted);
      stroke-width: 1;
      fill: none;
    }
    g rect {
      fill: var(--demo-bg);
    }
    g text {
      stroke: none;
      text-anchor: middle;
    }

    fieldset {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin: 16px 0;
      border: 1px solid var(--demo-line);
      border-radius: 8px;
    }
    summary {
      min-height: 44px;
    }
    .region {
      fill: var(--demo-accent);
      fill-opacity: 0.16;
      stroke: var(--demo-accent);
    }
    .material {
      stroke-dasharray: 6 4;
      stroke-width: 2;
    }

    @media (max-width: 680px) {
      .columns {
        grid-template-columns: 1fr;
      }
      .inputs {
        grid-template-columns: 1fr 1fr;
      }
      .card {
        padding: 12px;
      }
    }
    @media (max-width: 380px) {
      .inputs {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
