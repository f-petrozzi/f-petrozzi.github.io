---
import {
  createState,
  navigation,
  sectionTabs,
  sectionPreviews,
  stockLabels,
  week,
} from "../../data/demos/nest";
const id = `nest-${crypto.randomUUID()}`;
const initial = createState();
---

<section
  class="demo demo-nest"
  data-demo="nest"
  aria-label="Nest interactive sample"
>
  <header class="nest-header">
    <div class="nest-brand">
      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"
        ><path d="m5 14 11-9 11 9v12H5V14Z"></path><path
          d="M12 26v-9h8v9M10 10V6"></path></svg
      >
      <strong>Nest<span>Sam &amp; Riley’s home</span></strong>
    </div>
    <button type="button" class="nest-reset" data-reset>Reset</button>
  </header>
  <div class="nest-shell">
    <nav class="nest-nav" aria-label="Nest main navigation">
      {
        navigation.map((item) => (
          <button
            type="button"
            data-view={item.id}
            aria-pressed={item.id === "dashboard" ? "true" : "false"}
            aria-controls={`${id}-${item.id}`}
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </button>
        ))
      }
    </nav>
    <div class="nest-layout">
      <div
        class="nest-main"
        role="region"
        aria-label="Household workspace"
        tabindex="0"
      >
        <section
          data-panel="dashboard"
          id={`${id}-dashboard`}
          aria-label="Dashboard"
        >
          <div class="nest-heading">
            <div>
              <p class="nest-eyebrow">Wednesday 14 October</p><h2>Home</h2>
            </div><span class="nest-person" aria-label="Sam">S</span>
          </div>
          <p class="nest-welcome">Good morning, Sam</p>
          <div class="nest-dashboard-grid">
            <article class="nest-card">
              <p class="nest-eyebrow">Today at a glance</p><h3>
                Water the plants
              </h3><p class="nest-muted">Riley's task for Wednesday</p><p
                class="nest-metric"
                data-dashboard-tasks
              >
                1 task to do
              </p><button
                type="button"
                class="nest-text-button"
                data-open-view="tasks">Open Tasks</button
              >
            </article>
            <article class="nest-card">
              <p class="nest-eyebrow">Tonight's plan</p><h3>
                Chickpea &amp; spinach skillet
              </h3><p class="nest-muted">20 minutes for two</p><p
                class="nest-metric"
                data-dashboard-meal
              >
                Sam's cooking
              </p><button
                type="button"
                class="nest-text-button"
                data-open-view="kitchen"
                data-open-section="plan">Open Plan</button
              >
            </article>
            <article class="nest-card">
              <p class="nest-eyebrow">Household spending</p><h3>
                Latest grocery trip
              </h3><p class="nest-muted" data-dashboard-purchase>
                No trip logged today
              </p><button
                type="button"
                class="nest-text-button"
                data-open-view="kitchen"
                data-open-section="shop">Open Shop</button
              >
            </article>
            <article class="nest-card">
              <p class="nest-eyebrow">Cat care</p><h3>Juniper &amp; Miso</h3><p
                class="nest-muted"
              >
                Both fed at 07:30. Fresh water is ready.
              </p><button
                type="button"
                class="nest-text-button"
                data-open-view="cats">Open Cats</button
              >
            </article>
          </div>
        </section>
        <section
          data-panel="kitchen"
          id={`${id}-kitchen`}
          aria-label="Kitchen"
          hidden
        >
          <div class="nest-heading">
            <div>
              <p class="nest-eyebrow">12-18 October 2026</p><h2>Our kitchen</h2>
            </div><span class="nest-person">S <span>Sam</span></span>
          </div>
          <nav
            class="nest-subnav"
            role="tablist"
            aria-label="Kitchen sections"
            data-section-tabs="kitchen"
          >
            {
              sectionTabs.kitchen.map((label, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`${id}-kitchen-tab-${label.toLowerCase()}`}
                  data-section={label.toLowerCase()}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  aria-controls={`${id}-kitchen-${label.toLowerCase()}`}
                >
                  {label}
                </button>
              ))
            }
          </nav>
          <section
            class="nest-card nest-meal"
            id={`${id}-kitchen-plan`}
            role="tabpanel"
            tabindex="0"
            data-section-panel="kitchen"
            data-section-name="plan"
            aria-labelledby={`${id}-kitchen-tab-plan`}
          >
            <div class="nest-card-top">
              <h3>Plan</h3><span><span>Wed 14</span><span>Dinner</span></span>
            </div>
            <div class="nest-meal-art" aria-hidden="true">
              <svg viewBox="0 0 260 110" fill="none"
                ><ellipse
                  cx="130"
                  cy="57"
                  rx="94"
                  ry="43"
                  class="nest-plate-rim"></ellipse><ellipse
                  cx="130"
                  cy="57"
                  rx="76"
                  ry="33"
                  class="nest-plate"></ellipse><g class="nest-leaves"
                  ><path d="M96 59c-24-22-5-38 11-19 20-16 35 3 11 19Z"
                  ></path><path d="M148 74c-25-10-17-31 3-23 12-23 33-10 15 12Z"
                  ></path><path d="M129 44c-13-19 6-28 15-13 16-4 21 15 0 20Z"
                  ></path></g
                ><g class="nest-beans"
                  ><circle cx="104" cy="70" r="7"></circle><circle
                    cx="126"
                    cy="63"
                    r="7"></circle><circle cx="163" cy="45" r="7"
                  ></circle><circle cx="143" cy="76" r="6"></circle><circle
                    cx="84"
                    cy="51"
                    r="6"></circle><circle cx="132" cy="45" r="6"
                  ></circle><circle cx="177" cy="64" r="6"></circle></g
                ></svg
              >
            </div>
            <h4>Chickpea &amp; spinach skillet</h4>
            <div class="nest-meta">
              <span>20 min</span><span>For two</span><span>Sam’s cooking</span>
            </div>
            <button
              type="button"
              class="nest-text-button"
              data-open-view="kitchen"
              data-open-section="recipes">View recipe</button
            >
            <button type="button" class="nest-primary" data-made
              >Mark as made</button
            >
            <p class="nest-small" data-meal-status>Planned for Wednesday</p>
          </section>
          <section
            class="nest-card"
            role="tabpanel"
            tabindex="0"
            id={`${id}-kitchen-nesty`}
            data-section-panel="kitchen"
            data-section-name="nesty"
            aria-labelledby={`${id}-kitchen-tab-nesty`}
            hidden
          >
            <p class="nest-eyebrow">Nesty</p><h3>
              Dinner, with what we have
            </h3><p class="nest-muted">
              Chickpeas and spinach are on hand. The skillet fits tonight's
              plan.
            </p><button
              type="button"
              class="nest-text-button"
              data-open-view="kitchen"
              data-open-section="plan">Open Plan</button
            >
          </section>
          <section
            class="nest-card"
            role="tabpanel"
            tabindex="0"
            id={`${id}-kitchen-recipes`}
            data-section-panel="kitchen"
            data-section-name="recipes"
            aria-labelledby={`${id}-kitchen-tab-recipes`}
            hidden
          >
            <div class="nest-card-top">
              <h3>Recipes</h3><span>1 saved recipe</span>
            </div>
            <h4>Chickpea &amp; spinach skillet</h4><div class="nest-meta">
              <span>20 minutes</span><span>2 servings</span>
            </div>
            <ul class="nest-ingredients">
              <li>2 cans of chickpeas</li><li>1 bag of spinach</li><li>
                1 tablespoon of olive oil
              </li>
            </ul>
            <p class="nest-muted">
              Warm the chickpeas in oil. Fold in the spinach and cook until
              wilted.
            </p>
            <button
              type="button"
              class="nest-text-button"
              data-open-view="kitchen"
              data-open-section="plan">On Wednesday's plan</button
            >
          </section>
          <section
            class="nest-card nest-shop"
            id={`${id}-kitchen-shop`}
            role="tabpanel"
            tabindex="0"
            data-section-panel="kitchen"
            data-section-name="shop"
            aria-labelledby={`${id}-kitchen-tab-shop`}
            hidden
          >
            <div class="nest-card-top">
              <h3>Shop</h3><span>Log a trip</span>
            </div>
            <div data-receipt-start>
              <div class="nest-receipt-stage">
                <svg
                  class="nest-receipt"
                  viewBox="0 0 190 210"
                  role="img"
                  aria-label="Maple Market receipt: chickpeas $2.40, spinach $3.20, lemons $1.60, total $7.20"
                >
                  <path
                    d="M15 7h160v192l-10-6-10 6-10-6-10 6-10-6-10 6-10-6-10 6-10-6-10 6-10-6-10 6-10-6-10 6-10-6-10 6Z"
                    fill="#f6f4ee"></path>
                  <g fill="#273348" font-family="monospace"
                    ><text
                      x="95"
                      y="35"
                      text-anchor="middle"
                      font-size="14"
                      font-weight="bold">MAPLE MARKET</text
                    ><text x="95" y="53" text-anchor="middle" font-size="9"
                      >14 OCT 2026</text
                    ><text x="28" y="89" font-size="10">CHICKPEAS</text><text
                      x="161"
                      y="89"
                      text-anchor="end"
                      font-size="10">2.40</text
                    ><text x="28" y="111" font-size="10">SPINACH</text><text
                      x="161"
                      y="111"
                      text-anchor="end"
                      font-size="10">3.20</text
                    ><text x="28" y="133" font-size="10">LEMONS</text><text
                      x="161"
                      y="133"
                      text-anchor="end"
                      font-size="10">1.60</text
                    ><text x="28" y="168" font-size="12" font-weight="bold"
                      >TOTAL</text
                    ><text
                      x="161"
                      y="168"
                      text-anchor="end"
                      font-size="12"
                      font-weight="bold">$7.20</text
                    ></g
                  ><path
                    d="M28 65h133M28 145h133"
                    stroke="#a2a6ae"
                    stroke-dasharray="3 3"></path>
                </svg>
              </div>
              <button type="button" class="nest-primary" data-read
                >Read receipt</button
              >
              <p class="nest-small">Maple Market, 14 October</p>
            </div>
            <form data-receipt-review hidden>
              <h4 tabindex="-1" data-review-title>Review receipt</h4>
              <div data-receipt-items class="nest-review-items"></div>
              <div class="nest-total">
                <span>Selected items</span><strong aria-live="polite" data-total
                  >$7.20</strong
                >
              </div>
              <p class="nest-error" data-receipt-error role="alert" hidden></p>
              <button type="submit" class="nest-primary" data-save
                >Save &amp; restock pantry</button
              >
              <button type="button" class="nest-text-button" data-cancel-receipt
                >Cancel</button
              >
            </form>
            <div data-receipt-saved hidden>
              <div class="nest-saved-mark" aria-hidden="true">✓</div><h4>
                Trip saved
              </h4><p class="nest-muted">Maple Market, Sam</p><p
                class="nest-purchase"
                data-purchase
              >
              </p><p class="nest-small">
                Selected items restocked in the pantry
              </p><button
                type="button"
                class="nest-text-button"
                data-open-view="kitchen"
                data-open-section="pantry">View Pantry</button
              >
            </div>
          </section>
          <section
            class="nest-card nest-pantry"
            id={`${id}-kitchen-pantry`}
            role="tabpanel"
            tabindex="0"
            data-section-panel="kitchen"
            data-section-name="pantry"
            aria-labelledby={`${id}-kitchen-tab-pantry`}
            hidden
          >
            <div class="nest-card-top">
              <h3>Pantry</h3><span>What’s on hand</span>
            </div>
            <ul class="nest-pantry-list" data-pantry>
              {
                initial.pantry.map((item) => (
                  <li>
                    <>
                      <strong>{item.name}</strong>
                      <span data-stock={item.stock}>
                        {stockLabels[item.stock]}
                      </span>
                    </>
                  </li>
                ))
              }
            </ul>
          </section>
        </section>
        <section
          data-panel="tasks"
          id={`${id}-tasks`}
          aria-label="Tasks"
          hidden
        >
          <div class="nest-heading">
            <div>
              <p class="nest-eyebrow">Our household</p><h2>Tasks</h2>
            </div><span class="nest-person">S <span>Sam</span></span>
          </div>
          <ul class="nest-tasks" data-tasks aria-label="Household tasks"></ul>
          <button
            type="button"
            class="nest-text-button"
            data-open-view="calendar">View Calendar</button
          >
          <form class="nest-card nest-task-form" data-task-form>
            <label
              >Task<input
                name="title"
                type="text"
                value="Pick up the parcel"
                required
                maxlength="80"
                autocomplete="off"
              /></label
            >
            <div class="nest-task-fields">
              <label
                >Date<select name="date"
                  >{
                    week.map((day) => (
                      <option value={day.date} selected={day.number === 16}>
                        {day.day} {day.number} Oct
                      </option>
                    ))
                  }</select
                ></label
              ><label
                >For<select name="person"
                  ><option>Both</option><option>Sam</option><option
                    >Riley</option
                  ></select
                ></label
              >
            </div>
            <button class="nest-primary" type="submit">Add task</button>
          </form>
        </section>
        <section
          data-panel="calendar"
          id={`${id}-calendar`}
          aria-label="Calendar"
          hidden
        >
          <div class="nest-heading">
            <div>
              <p class="nest-eyebrow">Sam &amp; Riley</p><h2>Calendar</h2>
            </div><span class="nest-date-range">12-18 Oct 2026</span>
          </div>
          <div
            class="nest-week-scroll"
            role="region"
            aria-label="Household week"
            tabindex="0"
          >
            <div class="nest-week" data-week></div>
          </div>
          <div class="nest-week-heading">
            <h3>This week’s tasks</h3><button
              type="button"
              class="nest-text-button"
              data-open-tasks>Add a task</button
            >
          </div>
          <ul class="nest-tasks" data-tasks aria-label="Calendar tasks"></ul>
        </section>
        {
          sectionPreviews.map((section) => (
            <section
              data-panel={section.id}
              id={`${id}-${section.id}`}
              aria-label={section.title}
              hidden
            >
              <div class="nest-heading">
                <div>
                  <>
                    <p class="nest-eyebrow">{section.eyebrow}</p>
                    <h2>{section.title}</h2>
                  </>
                </div>
              </div>
              <nav
                class="nest-subnav"
                role="tablist"
                aria-label={`${section.title} sections`}
                data-section-tabs={section.id}
              >
                {section.tabs.map((label, index) => (
                  <button
                    type="button"
                    role="tab"
                    id={`${id}-${section.id}-tab-${label.toLowerCase()}`}
                    data-section={label.toLowerCase()}
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? 0 : -1}
                    aria-controls={`${id}-${section.id}-${label.toLowerCase()}`}
                  >
                    {label}
                  </button>
                ))}
              </nav>
              {section.cards.map((card, index) => (
                <article
                  class="nest-card"
                  role="tabpanel"
                  tabindex="0"
                  id={`${id}-${section.id}-${section.tabs[index].toLowerCase()}`}
                  data-section-panel={section.id}
                  data-section-name={section.tabs[index].toLowerCase()}
                  aria-labelledby={`${id}-${section.id}-tab-${section.tabs[index].toLowerCase()}`}
                  hidden={index !== 0}
                >
                  <h3>{card.title}</h3>
                  <p class="nest-metric">{card.value}</p>
                  <p class="nest-muted">{card.copy}</p>
                  {section.id === "finance" && index === 1 && (
                    <p class="nest-muted" data-finance-purchase>
                      No receipt purchase logged today.
                    </p>
                  )}
                </article>
              ))}
            </section>
          ))
        }
      </div>
      <aside class="nest-other" aria-label="Riley’s phone preview" tabindex="0">
        <div class="nest-phone-label">
          <span class="nest-avatar">R</span><div>
            <strong>Riley’s phone</strong><span>Same household</span>
          </div>
        </div>
        <div class="nest-phone">
          <div class="nest-phone-bar" aria-hidden="true"></div>
          <div class="nest-phone-title">
            <strong>Nest</strong><span
              >Up to date <i aria-hidden="true"></i></span
            >
          </div>
          <p class="nest-phone-update" data-device-update>All caught up.</p>
          <div class="nest-phone-section">
            <span class="nest-eyebrow">Our week</span><strong data-device-tasks
              >1 task, 0 done</strong
            ><p data-device-task>Water the plants, Wed 14</p>
          </div>
          <div class="nest-phone-section">
            <span class="nest-eyebrow">Dinner, Wed 14</span><strong
              >Chickpea &amp; spinach skillet</strong
            ><p data-device-meal>Planned by Sam</p>
          </div>
          <div class="nest-phone-section nest-phone-pantry">
            <span class="nest-eyebrow">Pantry</span><ul data-device-pantry></ul>
          </div>
          <div class="nest-phone-section" data-device-purchase hidden>
            <span class="nest-eyebrow">Latest trip</span><strong
              data-device-total></strong>
          </div>
          <div class="nest-phone-home" aria-hidden="true"></div>
        </div>
      </aside>
    </div>
  </div>
  <p class="nest-status" role="status" aria-live="polite" data-status>
    Home is up to date.
  </p>
  <p class="nest-note">
    This sample simulates AI receipt reading, stock suggestions and device
    updates locally.
  </p>
  <dialog class="nest-sheet" aria-label="Update pantry?" data-consume>
    <form method="dialog" data-stock-form>
      <span class="nest-sheet-handle" aria-hidden="true"></span><p
        class="nest-eyebrow"
      >
        Meal made
      </p><h3>Update pantry?</h3><p class="nest-muted">
        You cooked the skillet. What’s left?
      </p>
      <div class="nest-stock-rows" data-stock-rows></div>
      <div class="nest-sheet-actions">
        <button type="button" data-skip>Skip</button><button
          type="submit"
          class="nest-primary">Confirm pantry</button
        >
      </div>
    </form>
  </dialog>
</section>
<script>
  import "../../scripts/demos/nest";
</script>
<style is:inline>
  .demo-nest {
    --nest-bg: #111710;
    --nest-surface: #1b2518;
    --nest-tint: #283322;
    --nest-ink: #eee8db;
    --nest-muted: #b4b2a3;
    --nest-line: #465040;
    --nest-accent: #e8c276;
    --nest-accent-ink: #171b12;
    --nest-scrollbar: #718067;
    color-scheme: dark;
    container-type: inline-size;
    min-width: 0;
    margin: 28px 0;
    overflow: hidden;
    background: var(--nest-bg);
    color: var(--nest-ink);
    border: 1px solid var(--nest-line);
    border-radius: 18px;
    font-size: 14px;
    line-height: 1.5;

    * {
      box-sizing: border-box;
      scrollbar-width: thin;
      scrollbar-color: var(--nest-scrollbar) transparent;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--nest-scrollbar);
      border-radius: 8px;
    }
    [hidden] {
      display: none !important;
    }
    .nest-sr {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
    :is(button, input, select) {
      font: inherit;
      color: inherit;
    }
    button {
      min-height: 44px;
      border: 1px solid var(--nest-line);
      border-radius: 9px;
      background: var(--nest-surface);
      padding: 9px 14px;
      cursor: pointer;
      touch-action: manipulation;
    }
    button:disabled {
      opacity: 0.65;
      cursor: default;
    }
    :is(button, input, select, [tabindex]):focus-visible {
      outline: 2px solid var(--nest-accent);
      outline-offset: 2px;
    }
    input:not([type="checkbox"]),
    select {
      width: 100%;
      min-width: 0;
      min-height: 44px;
      padding: 9px 10px;
      border: 1px solid var(--nest-line);
      border-radius: 8px;
      background: var(--nest-bg);
      font-size: 16px;
    }
    input[type="checkbox"] {
      width: 20px;
      height: 20px;
      margin: 0;
      accent-color: var(--nest-accent);
      flex-shrink: 0;
    }
    :is(h2, h3, h4, p, ul) {
      margin: 0;
    }
    h2 {
      font-size: 26px;
      font-weight: 550;
      letter-spacing: -0.035em;
    }
    h3 {
      font-size: 16px;
      font-weight: 600;
    }
    h4 {
      font-size: 19px;
      font-weight: 550;
      line-height: 1.35;
    }
    ul {
      list-style: none;
      padding: 0;
    }
    .nest-header,
    .nest-heading,
    .nest-card-top,
    .nest-week-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .nest-header {
      padding: 16px 22px;
      border-bottom: 1px solid var(--nest-line);
    }
    .nest-brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .nest-brand svg {
      width: 32px;
      height: 32px;
      stroke: var(--nest-accent);
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .nest-brand strong {
      font-size: 23px;
      font-weight: 550;
      line-height: 1.2;
    }
    .nest-brand strong span {
      display: block;
      color: var(--nest-muted);
      font-size: 11px;
      font-weight: 400;
      margin-top: 3px;
    }
    .nest-reset,
    .nest-text-button {
      border-color: transparent;
      background: transparent;
      color: var(--nest-accent);
      font-size: 12px;
    }
    .nest-shell {
      display: grid;
      grid-template-columns: 80px minmax(0, 1fr);
    }
    .nest-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 8px 5px;
      background: var(--nest-surface);
      border-right: 1px solid var(--nest-line);
    }
    .nest-nav button {
      display: flex;
      flex-direction: column;
