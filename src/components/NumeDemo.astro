---
import Icon from "./Icon.astro";
---

<section class="nume-sample" aria-label="NüMe interactive sample">
  <aside class="sample-sidebar">
    <strong class="sample-brand">♡ NüMe</strong>
    <nav aria-label="Sample dashboard views">
      <button type="button" data-view="dashboard" aria-current="page"
        ><Icon name="grid" />Dashboard</button
      >
      <button type="button" data-view="health"
        ><Icon name="circle-dot" />Health</button
      >
      <button type="button" data-view="recipes"
        ><Icon name="book" />Recipes</button
      >
      <button type="button" data-view="agents"
        ><Icon name="brain-circuit" />Agent trace</button
      >
    </nav>
    <div class="sample-person">
      <strong>Alex Rivera</strong><span>Member</span>
    </div>
  </aside>
  <div class="sample-content">
    <div class="sample-toolbar">
      <span>Today</span><button type="button" class="sample-reset"
        >Reset sample</button
      >
    </div>
    <section data-panel="dashboard" aria-labelledby="sample-dashboard-title">
      <h2 id="sample-dashboard-title">Good morning, Alex</h2><p
        class="sample-muted"
      >
        Your plan and its context.
      </p>
      <div class="sample-scenario">
        <div>
          <strong>Daily inputs</strong>
        </div><div class="sample-preset">
          <button type="button" data-preset="low">Low sleep</button><button
            type="button"
            data-preset="rested">Rested</button
          >
        </div>
      </div>
      <div class="sample-inputs">
        <label
          >Sleep <output id="sample-sleep-label">5.2 hours</output><input
            type="range"
            id="sample-sleep"
            aria-label="Sample sleep hours"
            min="4"
            max="9"
            step="0.1"
            value="5.2"
          /></label
        >
        <label
          >Stress <output id="sample-stress-label">72 / 100</output><input
            type="range"
            id="sample-stress"
            aria-label="Sample stress level"
            min="10"
            max="90"
            step="1"
            value="72"
          /></label
        >
      </div>
      <p class="sample-message" aria-live="polite">
        Start with one good meal, a short walk and an earlier bedtime.
      </p>
      <div class="sample-metrics">
        <div>
          <span>Sleep</span><strong data-metric="sleep">5.2h</strong>
        </div><div>
          <span>Stress</span><strong data-metric="stress">72</strong>
        </div><div><span>Steps</span><strong>3,200</strong></div>
      </div>
      <section class="sample-agent" aria-labelledby="sample-agent-title">
        <div class="sample-agent-heading">
          <h3 id="sample-agent-title">Ask NüMe</h3>
        </div>
        <div class="sample-prompts" role="group" aria-label="Example questions">
          <button type="button" data-prompt="What should I eat?"
            >What should I eat?</button
          ><button type="button" data-prompt="Why this plan?"
            >Why this plan?</button
          >
        </div>
        <p class="sample-question" hidden></p><p
          class="sample-reply"
          role="status"
        >
          Ask about your sample day. I can explain meals, activity and the plan.
        </p>
        <form class="sample-chat-form">
          <label class="sample-chat-label" for="sample-question-input"
            >Your question</label
          ><div>
            <input
              id="sample-question-input"
              type="text"
              maxlength="200"
              autocomplete="off"
              placeholder="Ask about this sample day"
              required
            /><button type="submit">Send</button>
          </div>
        </form>
        <button type="button" class="sample-view-trace">View trace</button>
      </section>
      <div class="sample-plan">
        <article>
          <span class="sample-kicker">Meal</span><h3 data-meal-title>
            Spinach &amp; Walnut Power Salad
          </h3><p data-meal-copy>
            A simple meal with leafy greens, nuts and whole grains.
          </p><span class="sample-chip">10 min / low effort</span><details>
            <summary>Why this suggestion?</summary><p data-reason>
              Adds protein with little preparation.
            </p>
          </details><button
            type="button"
            class="sample-accept"
            aria-pressed="false">I'll do this</button
          >
        </article><article>
          <span class="sample-kicker">Activity</span><h3 data-activity-title>
            Gentle Movement Break
          </h3><p data-activity-copy>A 15-minute walk between classes.</p><span
            class="sample-chip">Low intensity / outdoors</span
          ><details>
            <summary>Why this suggestion?</summary><p>
              A short break suited to today’s inputs.
            </p>
          </details><button
            type="button"
            class="sample-accept"
            aria-pressed="false">I'll do this</button
          >
        </article>
      </div>
      <p class="sample-note">
        Local rules simulate replies and recommendations. No NüMe engine or
        external service runs.
      </p>
    </section>
    <section data-panel="health" hidden aria-labelledby="sample-health-title">
      <h2 id="sample-health-title">Health</h2><p class="sample-muted">
        Wearable metrics and weekly sleep.
      </p><div class="sample-metrics">
        <div>
          <span>Sleep</span><strong data-metric="sleep">5.2h</strong>
        </div><div>
          <span>Stress</span><strong data-metric="stress">72</strong>
        </div><div><span>Heart rate</span><strong>82 bpm</strong></div>
      </div><h3 class="sample-section-title">Sleep history</h3><div
        class="sample-sleep-history"
      >
        {
          [8.4, 7.6, 8.2, 6.9, 8.0].map((hours, i) => (
            <article>
              <>
                <div>
                  <>
                    <strong>
                      {
                        [
                          "Friday",
                          "Thursday",
                          "Wednesday",
                          "Tuesday",
                          "Monday",
                        ][i]
                      }
                    </strong>
                    <span>{hours} hours</span>
                  </>
                </div>
                <div
                  class="sample-sleep-bar"
                  role="img"
                  aria-label={`${hours} hours of sleep`}
                >
                  <i style={`width:${(hours / 9) * 100}%`} />
                </div>
                <p>
                  Deep sleep{" "}
                  <>
                    <span>Light sleep</span>
                    <span>REM</span>
                  </>
                </p>
              </>
            </article>
          ))
        }
      </div><p class="sample-note">
        Sleep and stress reflect dashboard inputs. History stays fixed.
      </p>
    </section>
    <section data-panel="recipes" hidden aria-labelledby="sample-recipes-title">
      <h2 id="sample-recipes-title">Recipes</h2><div
        class="sample-recipe-filters"
        role="group"
        aria-label="Sample recipe filters"
      >
        <button type="button" data-recipe-filter="all" aria-pressed="true"
          >All recipes</button
        ><button type="button" data-recipe-filter="quick" aria-pressed="false"
          >Under 15 minutes</button
        >
      </div><div class="sample-recipe-list">
        {
          [
            {
              name: "Spinach & Walnut Power Salad",
              time: 10,
              description: "Leafy greens, walnuts and extra protein.",
            },
            {
              name: "Calming Chamomile Oat Bowl",
              time: 12,
              description: "Warm oats, chamomile and fruit.",
            },
            {
              name: "Roasted Salmon with Vegetables",
              time: 30,
              description: "A filling meal for a longer cooking break.",
            },
          ].map((recipe) => (
            <details data-recipe-minutes={recipe.time}>
              <>
                <summary>
                  <>
                    <div>
                      <>
                        <strong>{recipe.name}</strong>
                        <span>{recipe.time} minutes</span>
                      </>
                    </div>
                    <span>View</span>
                  </>
                </summary>
                <p>{recipe.description}</p>
                <button
                  type="button"
                  class="sample-accept"
                  aria-pressed="false"
                >
                  Add to sample plan
                </button>
              </>
            </details>
          ))
        }
      </div>
    </section>
    <section data-panel="agents" hidden aria-labelledby="sample-agents-title">
      <div class="sample-trace-heading">
        <div>
          <h2 id="sample-agents-title">Agent trace</h2><p class="sample-muted">
            Steps behind the last answer.
          </p>
        </div><button type="button" class="sample-play"
          >Play sample trace</button
        >
      </div><p class="sample-trace-status" role="status">
        Local execution / select a stage to inspect its input and output.
      </p><div
        class="sample-flow"
        role="group"
        aria-label="Sample coordination stages"
      >
        {
          [
            {
              id: "coordinator",
              title: "Coordinator",
              tag: "Route the request",
            },
            {
              id: "parallel",
              title: "Signals & rules",
              tag: "Sleep / stress / effort",
            },
            {
              id: "specialist",
              title: "Catalog selector",
              tag: "Fixed sample options",
            },
            {
              id: "validation",
              title: "Validation",
              tag: "Supported response",
            },
            { id: "plan", title: "Reply", tag: "Bring it together" },
          ].map((stage, i) => (
            <button
              type="button"
              data-stage={stage.id}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              <>
                <span>{String(i + 1).padStart(2, "0")}</span>
                <strong>{stage.title}</strong>
                <small>{stage.tag}</small>
              </>
            </button>
          ))
        }
      </div><article class="sample-stage-detail" aria-live="polite">
        <span class="sample-kicker">Coordinator</span><h3>
          Route the request
        </h3><p>
          The coordinator routes sleep, stress, activity and check-in signals
          for analysis.
        </p>
        <dl class="sample-trace-data">
          <div><dt>Input</dt><dd data-trace-input></dd></div><div>
            <dt>Output</dt><dd data-trace-output></dd>
          </div>
        </dl>
      </article>
    </section>
  </div>
</section>
<script>
  import "../scripts/nume-sample";
</script>
<style is:inline>
  .nume-sample {
    --demo-bg: #f6f8fa;
    --demo-ink: #15252f;
    --demo-muted: #52677c;
    --demo-faint: #9aa9bd;
    --demo-accent: #1f7168;
    --demo-accent-ink: #fff;
    --demo-line: #dce4e9;
    --demo-glass-tint: #101826;
    color-scheme: light;
    background: var(--demo-bg);

    & {
      --sample-ink: #15252f;
      --sample-muted: #52677c;
      --sample-line: #dce4e9;
      --sample-teal: #1f7168;
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      overflow: hidden;
      border: 1px solid var(--demo-line);
      border-radius: 20px;
      background: #f6f8fa;
      color: var(--sample-ink);
      font-size: 14px;
      line-height: 1.55;
    }
    & button,
    & summary {
      touch-action: manipulation;
    }
    .sample-sidebar {
      display: flex;
      flex-direction: column;
      padding: 24px 12px;
      background: #171e27;
      color: #dce5ed;
    }
    .sample-brand {
      font-size: 21px;
      color: #fff;
      padding: 0 12px 24px;
    }
    .sample-sidebar nav {
      display: grid;
      gap: 5px;
    }
    .sample-sidebar nav button {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 44px;
      width: 100%;
      padding: 10px 12px;
      text-align: left;
      border: 0;
      border-radius: 9px;
      background: none;
      color: inherit;
      font: inherit;
    }
    .sample-sidebar nav button[aria-current] {
      color: #70e0d0;
      background: #26323b;
    }
    .sample-sidebar .ui-icon {
      width: 18px;
      height: 18px;
    }
    .sample-person {
      display: grid;
      margin-top: auto;
      padding: 48px 12px 0;
      font-size: 12px;
    }
    .sample-person span {
      color: #a9b8c7;
    }
    .sample-content {
      min-width: 0;
      padding: 24px 32px 32px;
    }
    .sample-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      font-size: 12px;
      color: var(--sample-muted);
    }
    .sample-toolbar button {
      background: none;
      border: 0;
      color: var(--sample-teal);
      padding: 10px;
      font: inherit;
      min-height: 44px;
    }
    & h2 {
      margin: 0 0 4px;
      font-size: 24px;
      line-height: 1.3;
      font-weight: 650;
      letter-spacing: -0.02em;
    }
    & h3 {
      margin: 8px 0;
      font-size: 17px;
      line-height: 1.35;
    }
    & p {
      margin: 6px 0;
    }
    .sample-muted,
    .sample-note {
      color: var(--sample-muted);
    }
    .sample-note {
      font-size: 12px;
      margin-top: 20px !important;
    }
    .sample-scenario {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 24px 0 16px;
    }
    .sample-scenario p {
      color: var(--sample-muted);
      font-size: 12px;
    }
    .sample-preset {
      display: flex;
      flex-shrink: 0;
      gap: 6px;
    }
    .sample-preset button,
    .sample-recipe-filters button {
      background: #e8efee;
      color: #216d64;
      border: 0;
      border-radius: 7px;
      padding: 10px 12px;
      min-height: 44px;
      font: inherit;
      font-size: 12px;
    }
    .sample-inputs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }
    .sample-inputs label {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      font-size: 13px;
    }
    .sample-inputs output {
      color: var(--sample-teal);
    }
    .sample-inputs input {
      width: 100%;
      margin: 10px 0;
      accent-color: var(--sample-teal);
      min-height: 28px;
    }
    .sample-message {
      padding: 16px;
      background: #e8f4f1;
      border-radius: 10px;
      color: #235e57;
    }
    .sample-metrics {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin: 20px 0;
    }
    .sample-metrics > div {
      display: grid;
      gap: 8px;
      padding: 16px;
      background: #fff;
      border: 1px solid var(--sample-line);
      border-radius: 10px;
    }
    .sample-metrics span {
      font-size: 12px;
      color: var(--sample-muted);
    }
    .sample-metrics strong {
      font-size: 24px;
      font-weight: 600;
    }
    .sample-plan {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .sample-plan article {
      padding: 18px;
      border: 1px solid var(--sample-line);
      background: #fff;
      border-radius: 12px;
    }
    .sample-kicker {
      color: var(--sample-teal);
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .sample-plan article > p {
      min-height: 44px;
      color: var(--sample-muted);
      font-size: 13px;
    }
    .sample-chip {
      display: inline-block;
      padding: 4px 8px;
      margin: 8px 0;
      background: #f0f4f5;
      border-radius: 20px;
      color: var(--sample-muted);
      font-size: 11px;
    }
    .sample-plan details {
      margin: 10px 0 16px;
      font-size: 12px;
    }
    .sample-plan summary {
      min-height: 32px;
      cursor: pointer;
      color: var(--sample-teal);
    }
    .sample-accept,
    .sample-play {
      font: inherit;
      font-size: 12px;
      min-height: 44px;
      padding: 10px 14px;
      border: 0;
      border-radius: 7px;
      background: var(--sample-teal);
      color: #fff;
    }
    .sample-accept[aria-pressed="true"] {
      background: #e5f3ee;
      color: #246d55;
    }
    .sample-section-title {
      margin-top: 24px !important;
    }
    .sample-sleep-history {
      display: grid;
      gap: 12px;
      margin-top: 16px;
    }
    .sample-sleep-history article {
      background: #fff;
      border: 1px solid var(--sample-line);
      border-radius: 10px;
      padding: 16px;
    }
    .sample-sleep-history article > div:first-child {
      display: flex;
      justify-content: space-between;
    }
    .sample-sleep-bar {
      background: #e9edf1;
      height: 10px;
      border-radius: 8px;
      margin-top: 12px;
      overflow: hidden;
    }
    .sample-sleep-bar i {
      display: block;
      height: 100%;
      background: linear-gradient(
        90deg,
        #8475f6 0 25%,
        #71a8f8 25% 75%,
        #b09afa 75%
      );
      border-radius: 8px;
    }
    .sample-sleep-history p {
      display: flex;
      gap: 18px;
      color: var(--sample-muted);
      font-size: 10px;
    }
    .sample-recipe-filters {
      display: flex;
      gap: 8px;
      margin: 24px 0;
    }
    .sample-recipe-filters button[aria-pressed="true"] {
      background: var(--sample-teal);
      color: #fff;
    }
    .sample-recipe-list {
      display: grid;
      gap: 12px;
    }
    .sample-recipe-list details {
      border: 1px solid var(--sample-line);
      background: #fff;
      padding: 16px;
      border-radius: 10px;
    }
    .sample-recipe-list summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      list-style: none;
      cursor: pointer;
      min-height: 44px;
    }
    .sample-recipe-list summary > div {
      display: grid;
      gap: 4px;
    }
    .sample-recipe-list summary span {
      font-size: 12px;
      color: var(--sample-muted);
    }
    .sample-recipe-list details > p {
      margin: 12px 0;
    }
    .sample-trace-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .sample-trace-status {
      margin: 20px 0 !important;
      color: var(--sample-teal);
      font-size: 12px;
    }
    .sample-flow {
      display: grid;
      gap: 12px;
    }
    .sample-flow button {
      position: relative;
      display: grid;
      grid-template-columns: 32px 1fr;
      text-align: left;
      gap: 2px 12px;
      padding: 14px;
      border: 1px solid var(--sample-line);
      border-radius: 10px;
      background: #fff;
      color: inherit;
      font: inherit;
      min-height: 64px;
    }
    .sample-flow button > span {
      grid-row: span 2;
      align-self: center;
      color: var(--sample-teal);
    }
    .sample-flow small {
      color: var(--sample-muted);
    }
    .sample-flow button[aria-pressed="true"] {
      border-color: var(--sample-teal);
      background: #e9f5f2;
    }
    .sample-flow button.is-complete::after {
      content: "✓";
      position: absolute;
      right: 14px;
      top: 18px;
      color: var(--sample-teal);
    }
    .sample-stage-detail {
      margin-top: 20px;
      padding: 20px;
      border-radius: 12px;
      background: #fff;
      border: 1px solid var(--sample-line);
    }
    @media (max-width: 900px) {
      & {
        grid-template-columns: 1fr;
      }
      .sample-sidebar {
        padding: 16px;
      }
      .sample-brand {
        padding: 0 0 14px;
      }
      .sample-sidebar nav {
        display: flex;
        flex-wrap: wrap;
      }
      .sample-sidebar nav button {
        width: auto;
        padding: 8px 10px;
        font-size: 12px;
        gap: 7px;
      }
      .sample-person {
        display: none;
      }
      .sample-content {
        padding: 20px;
      }
    }
    @media (max-width: 560px) {
      .sample-plan {
        grid-template-columns: 1fr;
      }
      .sample-scenario {
        display: block;
      }
      .sample-preset {
        margin-top: 12px;
      }
      .sample-inputs {
        grid-template-columns: 1fr;
        gap: 8px;
      }
      .sample-metrics {
        gap: 6px;
      }
      .sample-metrics > div {
        padding: 10px;
      }
      .sample-metrics strong {
        font-size: 20px;
      }
      .sample-trace-heading {
        display: block;
      }
      .sample-play {
        margin-top: 14px;
      }
      .sample-content {
        padding: 16px;
      }
    }

    .sample-agent {
      margin: 20px 0;
      padding: 18px;
      border: 1px solid var(--sample-line);
      border-radius: 12px;
      background: #fff;
    }
    .sample-agent-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .sample-agent-heading span {
      font-size: 11px;
      color: var(--sample-muted);
    }
    .sample-prompts {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 10px 0;
    }
    .sample-prompts button,
    .sample-view-trace {
      font: inherit;
      font-size: 12px;
      min-height: 44px;
      padding: 8px 10px;
      background: #e9f3f0;
      color: var(--sample-teal);
      border: 0;
      border-radius: 7px;
    }
    .sample-question {
      padding: 10px;
      border-radius: 8px;
      background: #f0f3f5;
    }
    .sample-reply {
      padding: 12px;
      border-radius: 8px;
      background: #e8f4f1;
      color: #235e57;
    }
    .sample-chat-label {
      display: block;
      font-size: 12px;
      margin: 12px 0 6px;
    }
    .sample-chat-form > div {
      display: flex;
      gap: 8px;
    }
    .sample-chat-form input {
      min-width: 0;
      width: 100%;
      font: inherit;
      font-size: 16px;
      min-height: 44px;
      padding: 8px 10px;
      border: 1px solid var(--sample-line);
      border-radius: 7px;
      background: #fff;
      color: var(--sample-ink);
    }
    .sample-chat-form button {
      border: 0;
      border-radius: 7px;
      background: var(--sample-teal);
      color: #fff;
      font: inherit;
      padding: 0 14px;
    }
    .sample-view-trace {
      margin-top: 10px;
      background: transparent;
      padding-left: 0;
      text-align: left;
    }
    .sample-trace-data {
      display: grid;
      gap: 12px;
      margin-top: 18px;
      font-size: 12px;
    }
    .sample-trace-data > div {
      padding: 12px;
      border-radius: 8px;
      background: #f1f5f5;
      min-width: 0;
    }
    .sample-trace-data dt {
      color: var(--sample-teal);
      font-weight: 600;
      margin-bottom: 6px;
    }
    .sample-trace-data dd {
      margin: 0;
      overflow-wrap: anywhere;
    }
